# ── Servidor ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=debug

# ── Base de datos ─────────────────────────────────────────────────────────
#
# En producción es el MySQL de Clever Cloud. Su complemento limita las
# conexiones simultáneas (5 en el plan pequeño), y Prisma abre por su cuenta
# el doble de núcleos más una: sin `connection_limit` el servidor empieza a
# rechazar conexiones en cuanto hay algo de tráfico.
#
#   mysql://USUARIO:CLAVE@HOST:3306/BASE?connection_limit=3&pool_timeout=20&connect_timeout=15
#
# En desarrollo sin red vale el MySQL local de XAMPP.

DATABASE_URL="mysql://root@localhost:3306/acostaresearch"

# ── CORS (separar múltiples orígenes con coma) ────────────────────────────
CORS_ORIGIN=http://localhost:4200

# ── JWT ───────────────────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=bfce9eebb51393b123c1d928e2b4e92b99ead97f823a0e54ac227733652bae5059c613fd3bc9139fed59e7a1808a3386
JWT_REFRESH_SECRET=3f094486033e2a1cc0649932b1d898bbf474eafa26e13e822660c8ac81349c717d6a722f69961db6de93caa3e562173b
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=acostaresearch-api
JWT_AUDIENCE=acostaresearch-web

# ── Cookies ───────────────────────────────────────────────────────────────
COOKIE_DOMAIN=
COOKIE_SECURE=false

# ── Verificación de email por código ─────────────────────────────────────────────────
EMAIL_VERIFICATION_TTL_MINUTES=15
APP_URL=http://localhost:4200

# ── Envío de correo (Brevo · SMTP) ────────────────────────────────────────
# La contraseña NO es la de tu cuenta: es una "SMTP key" de
# https://app.brevo.com/settings/keys/smtp
# Si SMTP_HOST o SMTP_PASS quedan vacíos, los correos se escriben en el log.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=stebandioses@gmail.com
SMTP_PASS=

# El remitente debe estar dado de alta y validado como "sender" en Brevo.
MAIL_FROM=lavaya.soport@gmail.com

# ── Datos iniciales (npm run db:seed) ─────────────────────────────────────
SEED_ADMIN_EMAIL=admin@acostaresearch.com
SEED_ADMIN_PASSWORD=Admin12345

# ── Reescritor académico (Claude) ─────────────────────────────────────────
# Clave en https://console.anthropic.com/settings/keys · vacía = función desactivada
ANTHROPIC_API_KEY=
REWRITE_MODEL=claude-opus-5
REWRITE_EFFORT=high
REWRITE_MAX_WORDS_PER_REQUEST=3000
TRIAL_PLAN_CODE=PRUEBA

# ── Pasarela de pago (PayPal) ─────────────────────────────────────────────
# Credenciales de la app en https://developer.paypal.com/dashboard/applications
# Vacías = no hay pago en línea y la venta sigue siendo manual por Yape.
# PayPal NO admite soles: los planes se cobran en dólares (Plan.priceUsdCents).
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ── Conector MCP (licencias de las skills) ────────────────────────────────
# URL pública que el comprador pega en Claude. En producción DEBE ser https
# y estar accesible desde internet: Claude llama desde la nube de Anthropic.
MCP_PUBLIC_URL=http://localhost:3000/mcp
LICENSE_PRODUCT_CODE=METODO_9_SKILLS
# Días de vigencia de una licencia nueva. 0 = hasta que se revoque.
LICENSE_DURATION_DAYS=0

# Modo simulado del conector (solo desarrollo): responde sin llamar a Anthropic.
SKILLS_SIMULADAS=false

# ── Pago manual por Yape ──────────────────────────────────────────────────
# Titular y número que acompañan al QR del checkout. Vacíos = solo el QR.
YAPE_TITULAR=
YAPE_NUMERO=
# Destinatario del aviso de comprobante pendiente. Vacío = primer ADMIN activo.
ADMIN_NOTIFY_EMAIL=
# Dónde se guardan las capturas. Tiene que ser un disco persistente.
# PROOFS_DIR=./storage/comprobantes
