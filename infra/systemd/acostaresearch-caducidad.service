[Unit]
Description=Aviso de caducidad de licencias de Acosta Research
After=network-online.target
# Si falla, aviso al móvil (acostaresearch-aviso@.service).
OnFailure=acostaresearch-aviso@%n.service

[Service]
Type=oneshot
User=acosta
Group=acosta
WorkingDirectory=/opt/acostaresearch/app
ExecStart=/usr/bin/node /opt/acostaresearch/app/scripts/avisar-caducidad.js
