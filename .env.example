# ── Servidor ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=debug

# ── Base de datos ─────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/acostaresearch?schema=public"

# ── CORS (separar múltiples orígenes con coma) ────────────────────────────
CORS_ORIGIN=http://localhost:4200

# ── JWT ───────────────────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_REFRESH_SECRET=cambia-esto-por-otro-secreto-distinto
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=acostaresearch-api
JWT_AUDIENCE=acostaresearch-web

# ── Cookies ───────────────────────────────────────────────────────────────
COOKIE_DOMAIN=
COOKIE_SECURE=false

# ── Verificación de email ─────────────────────────────────────────────────
EMAIL_VERIFICATION_TTL_HOURS=24
APP_URL=http://localhost:4200

# ── SMTP (si se deja vacío, los correos se escriben en el log) ────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Acosta Research <no-reply@acostaresearch.com>"
