// Esquema de autenticación — Acosta Research
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // El motor de consultas es un binario compilado para una arquitectura
  // concreta. "native" cubre el equipo donde se desarrolla (Windows x64) y el
  // segundo, el servidor: Ubuntu x86-64 con OpenSSL 3, que es lo que da un
  // Hetzner CX.
  //
  // Sin declararlo, el despliegue instala y compila sin una sola queja y luego
  // revienta en la primera consulta con un error sobre un motor que no
  // encuentra, sin decir que la causa es esta.
  //
  // Si el servidor pasara a ARM (línea CAX), cámbialo por
  // "linux-arm64-openssl-3.0.x".
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  EDITOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  /// La borró su dueño. La fila sigue ahí, vacía de datos personales, porque de
  /// ella cuelgan los pagos: borrarla de verdad se llevaría por delante las
  /// ventas, y una venta ocurrió aunque el comprador se vaya.
  DELETED
}

/// Cuentas reales: una fila aquí significa correo ya verificado.
/// El alta sin confirmar vive en `PendingRegistration`, no aquí.
model User {
  // MySQL no tiene tipo UUID nativo: se guarda como CHAR(36).
  id           String     @id @default(uuid()) @db.Char(36)
  email        String     @unique @db.VarChar(255)
  /// Nulo en las cuentas que entran con Google: ahí no hay contraseña que
  /// guardar, y un hash de relleno solo serviría para confundir.
  passwordHash String?    @db.VarChar(255)
  /// El `sub` de Google: identificador estable de la cuenta. El correo puede
  /// cambiar, esto no.
  googleId     String?    @unique @db.VarChar(64)
  firstName    String     @db.VarChar(80)
  lastName     String     @db.VarChar(80)
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)

  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  /// Cuándo pidió el dueño que se borrara. Nulo en una cuenta viva.
  deletedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]
  rewrites      Rewrite[]
  wordPacks     WordPack[]
  payments      Payment[]
  licenses      License[]
  /// Las fuentes que subió de su propio export de Scopus. Se van con la cuenta.
  references    Reference[]
  accountCodes  AccountCode[]
  /// Su tesis, y su artículo si también lo compró. Ver `Project`.
  projects      Project[]

  @@map("users")
}

/// Refresh tokens rotativos.
/// Solo se guarda el hash SHA-256: si se filtra la BD, los tokens no son usables.
/// `familyId` agrupa toda la cadena de rotaciones de una sesión, de modo que al
/// detectar la reutilización de un token ya rotado se revoca la familia completa.
model RefreshToken {
  id        String @id @default(uuid()) @db.Char(36)
  tokenHash String @unique @db.Char(64)
  familyId  String @db.Char(36)

  userId String @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  userAgent String? @db.VarChar(255)
  ip        String? @db.VarChar(45)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Alta a medias: los datos del registro esperan aquí hasta que se acierta el
/// código. Solo entonces nace el `User`, así que la tabla de usuarios nunca
/// contiene cuentas sin verificar.
///
/// Del código se guarda su SHA-256, nunca el valor en claro. `attempts` frena la
/// fuerza bruta: 6 dígitos son adivinables sin un tope de intentos.
model PendingRegistration {
  id           String @id @default(uuid()) @db.Char(36)
  email        String @unique @db.VarChar(255)
  passwordHash String @db.VarChar(255)
  firstName    String @db.VarChar(80)
  lastName     String @db.VarChar(80)

  codeHash  String   @db.Char(64)
  attempts  Int      @default(0)
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pending_registrations")
}

/// Cada capítulo de una tesis se redacta con convenciones distintas; el
/// reescritor necesita saber en cuál está para no romperlas.
enum ThesisChapter {
  GENERAL
  CAP_I_PROBLEMA
  CAP_II_MARCO_TEORICO
  CAP_III_METODOLOGIA
  CAP_IV_RESULTADOS
  CAP_V_DISCUSION
  CAP_VI_CONCLUSIONES
  RESUMEN_ABSTRACT
}

enum RewriteStatus {
  COMPLETED
  FAILED
}

/// Nivel de intervención sobre el texto original.
enum RewriteMode {
  LIGERO // corrige y pule, respeta al máximo la redacción original
  ESTANDAR // reescribe para claridad y registro académico
  PROFUNDO // reorganiza la sintaxis y la progresión de las ideas
}

/// Una reescritura pedida por un usuario. Guarda el original y el resultado
/// para que el tesista pueda comparar y recuperar su historial, y el consumo
/// real de tokens para poder auditar el coste y aplicar la cuota.
model Rewrite {
  id     String @id @default(uuid()) @db.Char(36)
  userId String @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mode    RewriteMode   @default(ESTANDAR)
  chapter ThesisChapter @default(GENERAL)
  status  RewriteStatus

  sourceText  String  @db.MediumText
  resultText  String? @db.MediumText
  sourceWords Int

  model        String  @db.VarChar(60)
  inputTokens  Int     @default(0)
  outputTokens Int     @default(0)
  cachedTokens Int     @default(0)
  /// Coste estimado en USD con las tarifas del modelo usado.
  costUsd      Decimal @default(0) @db.Decimal(10, 6)

  errorCode  String? @db.VarChar(60)
  durationMs Int?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("rewrites")
}

/// Cómo sirve el conector el contenido de una licencia.
///
/// Es la decisión que define el producto, y tiene un precio en los dos
/// sentidos:
///
///   EXECUTED     — el servidor ejecuta la skill y devuelve el resultado. El
///                  método no sale nunca del servidor, pero cada consulta
///                  consume tokens de nuestra cuenta.
///
///   INSTRUCTIONS — el conector entrega las instrucciones y el trabajo lo hace
///                  el Claude del comprador. No cuesta un céntimo, pero el
///                  contenido llega a su equipo: se puede leer desplegando el
///                  resultado de la herramienta, y ninguna instrucción lo
///                  impide, porque para entonces ya llegó. Lo que sí queda es
///                  el control de acceso, la revocación y la trazabilidad.
enum McpDelivery {
  EXECUTED
  INSTRUCTIONS
}

/// Qué entrega un plan al pagarlo.
enum PlanKind {
  WORDS // una bolsa de palabras para el humanizador
  LICENSE // una licencia del conector MCP (el método de las 9 skills)
}

/// Lo que se vende: una bolsa de palabras que caduca a los N días.
/// Los precios se guardan en céntimos para no arrastrar errores de coma flotante.
model Plan {
  id           String  @id @default(uuid()) @db.Char(36)
  code         String  @unique @db.VarChar(40)
  name         String  @db.VarChar(80)
  description  String? @db.VarChar(255)
  words        Int
  priceCents   Int
  currency     String  @default("PEN") @db.VarChar(3)
  durationDays Int     @default(30)
  active       Boolean @default(true)
  sortOrder    Int     @default(0)

  /// Qué recibe el comprador. Un plan LICENSE ignora `words` y `durationDays`
  /// se aplica a la licencia en vez de a la bolsa.
  kind        PlanKind @default(WORDS)
  /// Para los planes LICENSE: qué producto se licencia.
  productCode String?  @db.VarChar(40)

  /// Topes del conector, por licencia. 0 = sin tope.
  ///
  /// El que de verdad protege el margen es el de coste: treinta llamadas al
  /// capítulo de Metodología cuestan varias veces más que treinta a
  /// Conclusiones, porque cada skill pesa distinto. Contar llamadas aproxima
  /// mal; contar dólares no.
  mcpCallsPerDay       Int @default(0)
  mcpCallsPerMonth     Int @default(0)
  mcpCostCentsPerMonth Int @default(0)
  /// Topes TOTALES, sin reinicio. Son los que hacen viable un acceso
  /// permanente: si el producto no caduca, un tope mensual no tiene fondo
  /// —doce meses cuestan doce veces el mes— y acaba costando más que la venta.
  /// El acceso es para siempre; el uso incluido, finito.
  mcpCallsTotal        Int @default(0)
  mcpCostCentsTotal    Int @default(0)

  /// Cómo se sirve el contenido. Ver `McpDelivery`.
  mcpDelivery McpDelivery @default(EXECUTED)

  /// PayPal no admite soles: para cobrar por ahí hace falta un precio en USD.
  /// Nulo = el plan no se puede comprar con las pasarelas que cobran en dólares
  /// (seguirá activándose a mano por Yape).
  priceUsdCents Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  packs    WordPack[]
  payments Payment[]

  @@map("plans")
}

enum WordPackStatus {
  ACTIVE
  EXHAUSTED
  REVOKED
}

/// Una bolsa concreta comprada (o regalada) por un usuario.
/// La caducidad NO se guarda como estado: se compara `expiresAt` al consultarla,
/// así no hace falta ningún proceso que vaya marcando bolsas vencidas.
model WordPack {
  id String @id @default(uuid()) @db.Char(36)

  userId String @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId String @db.Char(36)
  plan   Plan   @relation(fields: [planId], references: [id])

  wordsTotal Int
  wordsUsed  Int            @default(0)
  status     WordPackStatus @default(ACTIVE)

  activatedAt DateTime @default(now())
  expiresAt   DateTime

  /// Trazabilidad del cobro manual: quién pagó, por dónde y con qué operación.
  paymentMethod String? @db.VarChar(30)
  paymentRef    String? @db.VarChar(80)
  amountCents   Int?
  note          String? @db.VarChar(255)

  /// Administrador que la activó. Null si la dio el sistema (prueba gratuita).
  grantedById String? @db.Char(36)

  createdAt DateTime @default(now())

  /// Cobro que la originó, si vino de una pasarela.
  payment Payment?

  @@index([userId, status, expiresAt])
  @@map("word_packs")
}

/// Estados de un cobro. No hay "reembolsado" todavía: cuando haga falta se
/// añade aquí y se refleja revocando la bolsa correspondiente.
enum PaymentStatus {
  PENDING // orden creada en la pasarela; el usuario aún no ha pagado nada
  IN_REVIEW // pago manual con comprobante enviado, a la espera de que el administrador lo mire
  PAID // cobro confirmado y bolsa entregada
  FAILED // la pasarela rechazó el cobro o devolvió algo que no cuadra
  REJECTED // el administrador revisó el comprobante y no lo dio por bueno
  CANCELLED // el usuario cerró la ventana sin llegar a pagar
}

/// Un intento de compra a través de una pasarela.
///
/// La fila se crea ANTES de cobrar, con el importe que nosotros calculamos a
/// partir del plan: al confirmar, se compara con lo que devuelve la pasarela y
/// solo se entrega la bolsa si coincide. Así el importe nunca lo decide el
/// navegador.
///
/// `provider` es texto y no un enum a propósito: añadir Culqi o Mercado Pago no
/// debe obligar a una migración de base de datos.
model Payment {
  id String @id @default(uuid()) @db.Char(36)

  userId String @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId String @db.Char(36)
  plan   Plan   @relation(fields: [planId], references: [id])

  provider          String        @db.VarChar(20)
  /// Identificador de la orden en la pasarela (en PayPal, el `orderID`).
  providerOrderId   String        @db.VarChar(120)
  /// Identificador del cobro ya efectuado, que es el que sirve para conciliar.
  providerCaptureId String?       @db.VarChar(120)
  status            PaymentStatus @default(PENDING)

  /// Importe esperado, en céntimos de `currency` (la moneda de la pasarela,
  /// que no tiene por qué ser la del plan).
  amountCents Int
  currency    String @db.VarChar(3)

  /// Lo entregado al confirmar el cobro. Solo uno de los dos, según el plan.
  wordPackId String?   @unique @db.Char(36)
  wordPack   WordPack? @relation(fields: [wordPackId], references: [id])
  licenseId  String?   @unique @db.Char(36)
  license    License?  @relation(fields: [licenseId], references: [id])

  /// Descuento aplicado, si el comprador usó un código promocional.
  discountCodeId String?       @db.Char(36)
  discountCode   DiscountCode? @relation(fields: [discountCodeId], references: [id])
  /// Rebaja en céntimos de la moneda del cobro, ya restada de `amountCents`.
  discountCents  Int           @default(0)

  payerEmail  String? @db.VarChar(255)
  errorCode   String? @db.VarChar(60)
  /// Respuesta cruda de la pasarela, para poder reclamar con pruebas.
  rawResponse String? @db.MediumText

  /// ── Pago manual (Yape o transferencia) ──────────────────────────────────
  /// Ruta del comprobante en disco, relativa al directorio de comprobantes. La
  /// imagen NO se guarda en la base de datos: son capturas de pantalla de un
  /// megabyte largo y aquí solo estorban a cada consulta de la tabla.
  proofPath     String?   @db.VarChar(255)
  proofMime     String?   @db.VarChar(40)
  /// Número de operación que muestra Yape. Es lo que permite cuadrar el
  /// comprobante con el extracto real sin fiarse de la captura.
  operationCode String?   @db.VarChar(40)
  /// Quién revisó el comprobante y qué decidió. Como el `createdById` de los
  /// códigos, va sin relación: es un apunte de auditoría, no algo que se
  /// navegue desde el usuario.
  reviewedById  String?   @db.Char(36)
  reviewedAt    DateTime?
  /// Motivo del rechazo. Se le enseña al comprador tal cual, así que se
  /// escribe pensando en que lo va a leer él.
  reviewNote    String?   @db.VarChar(255)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  paidAt    DateTime?

  @@unique([provider, providerOrderId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Licencias del conector MCP
// ─────────────────────────────────────────────────────────────────────────────

enum ActivationCodeStatus {
  AVAILABLE // generado y aún sin canjear
  REDEEMED // ya se cambió por una licencia
  VOID // anulado a mano antes de usarse
}

/// Código de un solo uso que se entrega al comprador tras la venta.
///
/// Se guarda solo su SHA-256, igual que los refresh tokens: si se filtra la
/// base de datos, los códigos no son canjeables. Como consecuencia, el código
/// en claro se ve UNA vez —al generarlo— y nunca más; por eso se guarda `hint`,
/// que permite reconocerlo en el panel sin poder reconstruirlo.
model ActivationCode {
  id       String @id @default(uuid()) @db.Char(36)
  codeHash String @unique @db.Char(64)
  hint     String @db.VarChar(12)

  /// Qué se está vendiendo. Permite tener varios productos con el mismo motor.
  productCode String               @db.VarChar(40)
  status      ActivationCodeStatus @default(AVAILABLE)

  buyerEmail String? @db.VarChar(255)
  note       String? @db.VarChar(255)

  /// El cobro que hubo detrás, cuando el dinero entró fuera de la web.
  ///
  /// Un código se reparte por dos motivos distintos y la diferencia importa:
  /// puede ser una venta cobrada por Western Union, transferencia o un Yape que
  /// llegó al WhatsApp, o puede ser una cortesía. Sin estos campos las dos
  /// entregaban lo mismo y ninguna dejaba rastro del dinero, así que esas ventas
  /// no existían en las cifras del panel.
  ///
  /// Se apunta aquí, al generar, y no al canjear: quien sabe cuánto se cobró y
  /// por dónde es el administrador en el momento de la venta. El pago se crea
  /// después, al canjear, porque hasta entonces no hay cuenta a la que colgarlo.
  ///
  /// `paymentMethod` nulo o CORTESIA = regalo: no se registra ningún cobro.
  paymentMethod String? @db.VarChar(30)
  /// Nº de operación o MTCN, para cuadrarlo contra el extracto real.
  paymentRef    String? @db.VarChar(80)
  amountCents   Int?

  /// Comprobante de la venta, si el administrador guardó uno. Opcional a
  /// propósito: una cortesía no tiene captura y una transferencia que ya se vio
  /// en el extracto tampoco la necesita.
  ///
  /// Como en los pagos por Yape, la imagen va a disco y aquí solo queda su
  /// ruta: pesa uno o dos megabytes y dentro de una tabla que se lista entera
  /// en el panel solo estorbaría.
  proofPath String? @db.VarChar(255)
  proofMime String? @db.VarChar(40)

  createdById  String?   @db.Char(36)
  redeemedById String?   @db.Char(36)
  redeemedAt   DateTime?
  /// Caducidad del código sin canjear. Nula = no caduca.
  expiresAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  license License?

  @@index([productCode, status])
  @@map("activation_codes")
}

enum LicenseStatus {
  ACTIVE
  SUSPENDED // parada temporalmente, se puede reactivar
  REVOKED // cancelada; el token no vuelve a servir
}

/// El acceso vivo de un comprador al conector MCP.
///
/// El token viaja dentro de la URL del conector, así que el comprador lo ve.
/// Se guarda hasheado de todos modos: el objetivo no es ocultárselo a él, sino
/// que una filtración de la base de datos no entregue todas las licencias.
model License {
  id String @id @default(uuid()) @db.Char(36)

  userId String @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productCode String        @db.VarChar(40)
  tokenHash   String        @unique @db.Char(64)
  /// Primeros caracteres del token, para identificarla en el panel.
  tokenHint   String        @db.VarChar(12)
  status      LicenseStatus @default(ACTIVE)

  activationCodeId String?         @unique @db.Char(36)
  activationCode   ActivationCode? @relation(fields: [activationCodeId], references: [id])

  /// Contadores acumulados: el motor de detección compara el uso de hoy contra
  /// el histórico del propio comprador, que es la señal que sí se sostiene.
  callsTotal Int       @default(0)
  lastUsedAt DateTime?

  /// Topes copiados del plan al comprar. Se guardan aquí y no se leen del plan
  /// cada vez a propósito: subir o bajar el precio de un plan no debe cambiar
  /// lo que compró alguien el mes pasado.
  callsPerDay         Int @default(0)
  callsPerMonth       Int @default(0)
  costCentsPerMonth   Int @default(0)
  callsLimitTotal     Int @default(0)
  costCentsLimitTotal Int @default(0)

  /// Copiado del plan al emitirla, como los topes.
  delivery McpDelivery @default(EXECUTED)

  /// Última vez que el motor de detección la revisó. Evita recalcular treinta
  /// días de historial en cada llamada.
  lastCheckedAt DateTime?

  revokedAt     DateTime?
  revokedReason String?   @db.VarChar(255)
  /// Caducidad del acceso. Nula = mientras no se revoque.
  expiresAt     DateTime?
  /// Cuándo se avisó al comprador de que su acceso estaba por caducar. Guarda
  /// la fecha y no un booleano para que se vea, meses después, si el aviso
  /// salió a tiempo o el día antes.
  expiryWarnedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usages   LicenseUsage[]
  alerts   LicenseAlert[]
  sessions McpSession[]
  counter  LicenseCounter?
  /// Cobro que la originó, si se compró por la web en vez de canjear un código.
  payment  Payment?

  @@index([userId, status])
  @@map("licenses")
}

/// Una llamada al conector. Es la materia prima del motor de detección.
///
/// NO se guarda la IP del comprador porque no existe: Claude llama desde la
/// infraestructura de Anthropic, así que todas las peticiones llegan del mismo
/// rango de direcciones sea quien sea el que pregunta. Lo que sí distingue a un
/// token compartido es el volumen frente a su propio histórico, el solapamiento
/// de llamadas y la incoherencia entre consultas seguidas.
model LicenseUsage {
  id String @id @default(uuid()) @db.Char(36)

  licenseId String  @db.Char(36)
  license   License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  tool       String  @db.VarChar(60)
  /// SHA-256 del texto de la consulta. Permite comparar si dos llamadas
  /// seguidas hablan de lo mismo sin conservar lo que escribió el tesista.
  promptHash String? @db.Char(64)
  /// Sesión declarada por el cliente, cuando la hay: dos sesiones distintas
  /// vivas a la vez sobre el mismo token es la señal más difícil de disimular.
  sessionId  String? @db.VarChar(64)

  ok         Boolean   @default(true)
  durationMs Int?
  kind       UsageKind @default(NORMAL)

  /// Consumo real de la llamada. Es lo que se compara contra el tope de gasto,
  /// y lo que permite saber de verdad cuánto cuesta cada capítulo.
  inputTokens  Int @default(0)
  outputTokens Int @default(0)
  cachedTokens Int @default(0)
  costCents    Int @default(0)

  createdAt DateTime @default(now())

  @@index([licenseId, createdAt])
  @@map("license_usages")
}

/// Una de las skills del método, tal como la ve el conector.
///
/// El contenido NO está aquí: vive en el bundle `.skill` y, una vez subido, en
/// la Skills API de Anthropic. Esta tabla solo guarda qué existe, cómo se llama
/// de cara al comprador y con qué identificador invocarla.
model Skill {
  id    String @id @default(uuid()) @db.Char(36)
  /// El `name` del frontmatter del SKILL.md. Es la clave estable.
  code  String @unique @db.VarChar(64)
  orden Int

  /// En qué grupos aparece. Ver `SkillGroup`.
  ///
  /// Sin ninguna fila = visible para cualquier licencia. No es la vía normal,
  /// pero evita que una skill subida sin elegir grupo desaparezca en silencio:
  /// es más fácil de detectar un capítulo que se ve de más que uno que no se ve.
  groups SkillGroup[]

  displayName String @db.VarChar(120)
  /// Resumen para el catálogo. Es lo ÚNICO del contenido que ve el comprador.
  summary     String @db.VarChar(500)
  bundlePath  String @db.VarChar(255)

  /// Identificadores en la Skills API. Nulos mientras no se haya subido.
  anthropicSkillId   String? @db.VarChar(80)
  anthropicVersionId String? @db.VarChar(80)

  /// Tamaño del SKILL.md, para vigilar el coste por invocación.
  skillMdBytes Int @default(0)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("skills")
}

/// En qué grupos aparece un capítulo.
///
/// UNA SKILL PUEDE ESTAR EN VARIOS GRUPOS A LA VEZ
/// -----------------------------------------------
/// Antes esto era una columna `productCode` en `skills`, es decir, un capítulo
/// pertenecía a un grupo y solo a uno. Y eso no describe el negocio: «Tema y
/// delimitación» es el primer capítulo del método de tesis Y del pack de tesis
/// con humanizador. Con una columna, meterlo en el segundo lo sacaba del
/// primero sin avisar, y el grupo de al lado se quedaba sin capítulo.
///
/// El orden se queda en `Skill.orden`, no aquí: los grupos que comparten
/// capítulos comparten también la secuencia del método, que es justo por lo que
/// los comparten.
model SkillGroup {
  skillId String @db.Char(36)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  /// El `productCode` del plan que vende ese grupo. No es una clave foránea
  /// porque el plan se identifica por `code` y varios planes pueden compartir
  /// `productCode`: lo que se comprueba, en el servicio, es que exista alguno.
  productCode String @db.VarChar(40)

  createdAt DateTime @default(now())

  @@id([skillId, productCode])
  @@index([productCode])
  @@map("skill_groups")
}

/// Contadores del conector, uno por licencia.
///
/// Existe para que comprobar el límite sea una sola lectura por id, en vez de
/// contar filas de `license_usages` en cada llamada.
///
/// El reinicio no necesita ningún proceso programado: se guarda el día y el mes
/// en curso como texto, y si el sello no coincide con hoy, el contador vale
/// cero. Un servidor apagado una semana vuelve con las cuentas correctas.
model LicenseCounter {
  licenseId String  @id @db.Char(36)
  license   License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  callsToday     Int @default(0)
  callsMonth     Int @default(0)
  costCentsToday Int @default(0)
  costCentsMonth Int @default(0)

  /// Acumulados desde el primer día y sin reinicio: se comparan contra los
  /// topes totales. Solo suman las llamadas que de verdad se sirvieron.
  callsLifetime     Int @default(0)
  costCentsLifetime Int @default(0)

  /// Sellos en hora de Lima: el día del comprador, no el del servidor.
  dayStamp   String @db.VarChar(10)
  monthStamp String @db.VarChar(7)

  updatedAt DateTime @updatedAt

  @@map("license_counters")
}

/// Qué clase de llamada fue. Alimenta tanto los límites como la detección.
enum UsageKind {
  NORMAL // consulta legítima
  EXTRACTION_ATTEMPT // intento de sacar las instrucciones internas
  BLOCKED_LIMIT // rechazada por haber agotado el tope
}

enum AlertKind {
  VOLUMEN
  SESIONES_SOLAPADAS
  CONSULTAS_INCOHERENTES
  EXTRACCION
}

enum AlertLevel {
  ALERTA
  SOSPECHA_ALTA
}

enum AlertAction {
  NINGUNA
  NOTIFICADO
  REVOCADO
}

/// Lo que el motor de detección encontró, guardado en vez de recalculado.
///
/// Hace falta que quede escrito por dos razones: para que la regla de "a la
/// segunda se revoca" tenga memoria, y para poder explicarle a un comprador
/// por qué se le cortó el acceso.
model LicenseAlert {
  id String @id @default(uuid()) @db.Char(36)

  licenseId String  @db.Char(36)
  license   License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  kind   AlertKind
  level  AlertLevel
  action AlertAction @default(NINGUNA)

  /// Las métricas que la dispararon, para poder revisarla meses después.
  detalle String? @db.VarChar(500)

  createdAt DateTime @default(now())

  @@index([licenseId, createdAt])
  @@map("license_alerts")
}

/// Código promocional que rebaja el precio de una compra.
///
/// A diferencia de `ActivationCode`, este SÍ se guarda en claro: no es una
/// credencial que dé acceso a nada, sino una rebaja, y el administrador
/// necesita releerlo para reenviárselo a un cliente o publicarlo.
///
/// La rebaja se define en céntimos de SOL, que es la moneda en la que se
/// anuncian los precios. Al cobrar en dólares se traslada la misma proporción,
/// para que el descuento anunciado y el cobrado coincidan.
model DiscountCode {
  id   String @id @default(uuid()) @db.Char(36)
  code String @unique @db.VarChar(40)

  amountCents Int

  /// Plan al que se limita. Nulo = vale para cualquiera.
  planCode String? @db.VarChar(40)

  /// Cuántas veces puede canjearse en total. 0 = sin límite.
  maxUses   Int @default(0)
  usedCount Int @default(0)

  active    Boolean   @default(true)
  expiresAt DateTime?
  note      String?   @db.VarChar(255)

  createdById String?  @db.Char(36)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments Payment[]

  @@index([active, expiresAt])
  @@map("discount_codes")
}

/// Una conversación abierta con una skill a través del conector.
///
/// Las skills del método CONVERSAN: preguntan, esperan respuesta y avanzan por
/// pasos. Una llamada a una herramienta MCP es de un solo tiro, así que el hilo
/// tiene que vivir aquí: el cliente manda un identificador y el servidor
/// recupera lo hablado.
model McpSession {
  id String @id @default(uuid()) @db.Char(36)

  licenseId String  @db.Char(36)
  license   License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  skillCode String @db.VarChar(64)
  /// Identificador que elige el cliente para su hilo.
  clientKey String @db.VarChar(64)

  /// La conversación, en el formato de la Messages API.
  messages String @db.LongText

  /// Contenedor de ejecución que se reutiliza entre turnos: dentro viven los
  /// .docx que va generando la skill. Caduca solo, y entonces se empieza otro.
  containerId String?   @db.VarChar(120)
  expiresAt   DateTime?

  turns       Int @default(0)
  /// Último tramo del método entregado, en las licencias de entrega.
  /// Permite servir el paso siguiente sin que el cliente lleve la cuenta.
  lastSection Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Un cliente no puede tener dos hilos con la misma clave.
  @@unique([licenseId, clientKey])
  @@index([licenseId, updatedAt])
  @@map("mcp_sessions")
}

/// Código de un solo uso para confirmar un cambio delicado en una cuenta que YA
/// existe: hoy, cambiar la contraseña.
///
/// No se reutiliza `PendingRegistration` porque no es lo mismo: allí el usuario
/// todavía no existe y la fila ES el alta a medias. Aquí la cuenta existe, el
/// código solo autoriza una operación, y al gastarse desaparece.
///
/// La pareja (usuario, propósito) es única: pedir otro código sustituye al
/// anterior en vez de dejar varios vivos. Un código viejo que siga valiendo es
/// exactamente lo que no se quiere de una cosa que se manda por correo.
model AccountCode {
  id String @id @default(uuid()) @db.Char(36)

  userId String @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Qué autoriza al acertarlo. Hoy solo PASSWORD.
  purpose String @db.VarChar(30)

  codeHash String @db.Char(64)
  /// Fallos seguidos. Al llegar al tope el código muere y hay que pedir otro.
  attempts Int    @default(0)

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, purpose])
  @@map("account_codes")
}

/// Una fuente bibliográfica del corpus de la casa.
///
/// El corpus se cura en Zotero, no aquí: allí está el conector del navegador
/// que captura una ficha de Scopus o de Scielo en un clic, y el editor con el
/// que se corrige un autor mal puesto. Esta tabla es un espejo de solo lectura.
///
/// POR QUÉ SE ESPEJA EN VEZ DE CONSULTAR ZOTERO EN VIVO
/// ----------------------------------------------------
/// El límite de peticiones de Zotero es por cuenta, y la cuenta es UNA para
/// todos los clientes a la vez: un día bueno de ventas bloquearía a todos. Y
/// una consulta en vivo mete a un tercero dentro de cada turno de Claude, así
/// que un rato lento de Zotero es un rato lento del producto, y una caída suya
/// es una caída nuestra. Sincronizar es barato —la API devuelve solo lo que
/// cambió— y deja al conector leyendo de la misma base que todo lo demás.
model Reference {
  id String @id @default(uuid()) @db.Char(36)

  /// La clave del ítem en Zotero. Es la identidad de la fuente EN EL FONDO DE
  /// LA CASA: al sincronizar se actualiza por ella, de modo que corregir una
  /// ficha en Zotero corrige la fila y no crea una segunda.
  ///
  /// NULA en lo que sube un comprador desde Scopus: eso no viene de Zotero y no
  /// tiene clave que traer. MySQL admite tantos nulos como quiera en un índice
  /// único, así que la columna sigue siendo única para las que sí la tienen y
  /// no estorba a las que no. Esa es toda la migración que hizo falta.
  zoteroKey String? @unique @db.VarChar(16)
  /// Versión del ítem en Zotero, para pedir solo lo modificado. 0 en lo importado.
  version   Int

  /// De quién es esta fuente.
  ///
  /// NULA = del fondo de la casa, que es lo que ven todas las licencias. Con
  /// valor, es de ese comprador y NO LA VE NADIE MÁS. Es el filtro que no puede
  /// fallar: un descuido aquí enseña el material de un tesista a otro.
  ///
  /// Va en la fila y no como etiqueta a propósito. El export de Scopus lo
  /// descargó él con la suscripción de su universidad: es suyo, se borra con su
  /// cuenta, y no se funde con el corpus que se sirve a los demás.
  ownerUserId String? @db.Char(36)
  owner       User?   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  /// De dónde salió: ZOTERO (la casa) o SCOPUS (subida por un comprador).
  ///
  /// Se guarda porque cambia lo que se le dice al asistente: lo de la casa lleva
  /// la nota de Acosta y lo importado no, y esa diferencia tiene que llegarle al
  /// conector para que no las presente como si fueran lo mismo.
  origin ReferenceOrigin @default(ZOTERO)

  /// Identidad de una fuente importada: su DOI, o el EID de Scopus, o el título
  /// normalizado si no trae ninguno de los dos. Nula en el fondo de la casa,
  /// que se identifica por su clave de Zotero.
  ///
  /// Junto con el dueño forma la clave que evita duplicados: volver a subir el
  /// mismo export no crea una segunda copia de nada.
  sourceRef String? @db.VarChar(200)

  itemType String  @db.VarChar(40)
  title    String  @db.VarChar(500)
  /// Autores ya formateados: «Hernández, R.; Fernández, C.».
  authors  String  @db.VarChar(500)
  year     Int?
  /// Revista, libro, congreso o editorial, según el tipo de fuente.
  source   String? @db.VarChar(300)
  doi      String? @db.VarChar(200)
  url      String? @db.VarChar(500)
  abstract String? @db.Text

  /// Las notas del ítem, unidas y sin etiquetas HTML.
  ///
  /// Vale más que el resumen: el resumen lo escribió la revista para vender su
  /// artículo, y la nota la escribió Acosta diciendo para qué sirve esta fuente
  /// y qué afirmación respalda.
  notes String? @db.Text

  /// Las etiquetas de Zotero, separadas por coma. Se guardan como texto porque
  /// se muestran; el filtro por producto NO se hace aquí, sino en `groups`.
  tags String @default("") @db.VarChar(500)

  /// Título, autores, resumen, notas y etiquetas en minúsculas y sin tildes.
  ///
  /// Una sola columna para buscar. Con un corpus de cientos de fuentes —no de
  /// millones— un LIKE sobre este campo responde de sobra, y evita depender de
  /// los índices de texto completo, que en Prisma siguen tras una bandera.
  busqueda String @db.Text

  groups ReferenceGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerUserId, sourceRef])
  @@index([ownerUserId])
  @@index([year])
  @@map("references")
}

/// De dónde salió una fuente. Ver el campo `origin` de `Reference`.
enum ReferenceOrigin {
  /// La biblioteca curada de la casa, espejada desde Zotero. Lleva nota.
  ZOTERO
  /// Un export que subió un comprador. Trae resumen, no lleva nota.
  SCOPUS
}

/// A qué productos pertenece una fuente. Mismo trato que `SkillGroup`.
///
/// SIN NINGUNA FILA = VISIBLE PARA TODOS, y aquí eso no es un caso raro sino lo
/// habitual: la metodología —Hernández Sampieri, Creswell, las normas APA—
/// sirve igual a quien escribe una tesis que a quien manda un artículo a una
/// revista. Solo se etiqueta lo que de verdad pertenece a una ruta.
model ReferenceGroup {
  referenceId String    @db.Char(36)
  reference   Reference @relation(fields: [referenceId], references: [id], onDelete: Cascade)

  /// El `productCode` del plan, igual que en `skill_groups`. No es clave
  /// foránea por la misma razón que allí.
  productCode String @db.VarChar(40)

  createdAt DateTime @default(now())

  @@id([referenceId, productCode])
  @@index([productCode])
  @@map("reference_groups")
}

/// Marcador de la última sincronización. Una sola fila, siempre la 1.
///
/// Guarda la versión de la biblioteca, no la fecha: Zotero versiona la
/// biblioteca entera con un número que crece, y pedir `?since=<esa versión>`
/// devuelve exactamente lo que cambió desde entonces, borrados incluidos. Con
/// una fecha habría que traerlo todo y comparar.
model ReferenceSync {
  id             Int       @id @default(1)
  libraryVersion Int       @default(0)
  lastRunAt      DateTime?
  /// Cuántas fuentes quedaron tras la última pasada. Es lo que enseña el panel.
  lastCount      Int       @default(0)
  /// Cerrojo entre procesos: cuándo entró quien está sincronizando ahora mismo.
  /// Nulo = no hay nadie dentro. Lo toma un UPDATE condicional, que es atómico,
  /// así que el panel y la tarea nocturna no pueden solaparse. Guarda la hora y
  /// no un sí/no para poder soltarlo si el proceso murió a media pasada.
  runningSince   DateTime?

  @@map("reference_sync")
}

/// Un video de la página de tutoriales.
///
/// Vive en la base y no en el código por una razón práctica: quien graba los
/// videos no despliega. Tenerlos escritos en un archivo obligaba a editar
/// TypeScript y empujar a git para publicar una URL de YouTube, que es pedirle
/// a alguien que aprenda git para hacer su trabajo.
///
/// Todo lo que se ve en la tarjeta se edita desde el panel: el título, la
/// duración, el texto y los puntos. Los puntos son texto con un salto de línea
/// por punto, no JSON, porque se escriben en un cuadro de texto normal y a nadie
/// le apetece cerrar corchetes para añadir una viñeta.
model Tutorial {
  id String @id @default(uuid()) @db.Char(36)

  /// En qué orden salen. Tienen orden de verdad: el primero se ve una vez y el
  /// segundo es el que hay que ver.
  orden Int

  titulo   String @db.VarChar(160)
  /// «5 min». Para que se sepa si hay tiempo de verlo ahora o hay que dejarlo.
  duracion String @db.VarChar(24)
  /// Qué problema resuelve, en una o dos frases.
  entrada  String @db.VarChar(600)
  /// Lo que se ve, un punto por línea. Es también el guion de la grabación.
  puntos   String @db.Text

  /// Enlace de YouTube. VACÍO = todavía no está grabado, y la tarjeta lo dice
  /// en lugar de dejar un hueco negro.
  videoUrl String @default("") @db.VarChar(500)

  /// Apagado se queda fuera de la página pública pero no se pierde. Sirve para
  /// retirar un video que quedó viejo —la interfaz de Claude cambia— mientras
  /// se regraba, en vez de borrarlo y volver a escribirlo todo.
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orden])
  @@map("tutorials")
}

// ─────────────────────────────────────────────────────────────────────────────
// El proyecto del tesista
// ─────────────────────────────────────────────────────────────────────────────

/**
 * En qué punto está una etapa.
 *
 * Solo tres, y el salto de EN_CURSO a LISTO lo da el tesista, no el asistente.
 * Que un capítulo se dé por bueno solo porque se escribió mucho es exactamente
 * lo que produce una tesis que no se sostiene ante el jurado.
 */
enum StageState {
  PENDIENTE
  EN_CURSO
  LISTO
}

/**
 * La memoria de una tesis, o de un artículo.
 *
 * Hasta ahora el conector respondía y olvidaba: cada conversación empezaba de
 * cero y el tesista volvía a contar su tema, sus objetivos y su metodología. Si
 * abría un chat nuevo, había perdido el hilo. Esto es lo que faltaba para que
 * «sigue con mi tesis» signifique algo.
 *
 * Uno por comprador y producto. Un tesista tiene UNA tesis; si además compra la
 * ruta del artículo, eso es otro proyecto y no debe mezclarse con el primero.
 * No se permiten dos tesis a la vez a propósito: es la forma más rápida de que
 * alguien escriba el capítulo IV de la que no era.
 */
model Project {
  id     String @id @default(uuid()) @db.Char(36)
  userId String @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Qué método sigue este proyecto. Mismo código que la licencia.
  productCode String @db.VarChar(40)

  /// El tema, tal y como el tesista lo tiene delimitado ahora mismo. Cambia:
  /// se guarda el vigente, no el histórico.
  tema        String? @db.VarChar(500)
  carrera     String? @db.VarChar(160)
  universidad String? @db.VarChar(160)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages ProjectStage[]

  /// Un proyecto por comprador y método.
  @@unique([userId, productCode])
  @@map("projects")
}

/**
 * Lo que quedó decidido en un capítulo.
 *
 * `resumen` es prosa corta y es lo que de verdad se usa: se le entrega al
 * asistente al empezar el capítulo siguiente para que no pregunte lo que ya se
 * habló. `datos` queda para cuando las Skills devuelvan estado estructurado
 * —variables, población, diseño— y todavía no lo hacen; existe para que ese
 * trabajo tenga dónde caer sin otra migración.
 *
 * No guarda el texto del capítulo. Esto es la memoria de lo acordado, no el
 * documento: el documento es otra etapa y otro problema.
 */
model ProjectStage {
  id        String  @id @default(uuid()) @db.Char(36)
  projectId String  @db.Char(36)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// La clave del capítulo, la misma que usa `redactar`. No es clave foránea
  /// contra `skills` porque un capítulo retirado del catálogo no puede borrar
  /// el avance de nadie.
  skillCode String @db.VarChar(64)

  estado  StageState @default(PENDIENTE)
  /// Qué quedó decidido, en dos o tres frases.
  resumen String?    @db.Text
  /// Lo mismo pero estructurado, cuando lo haya.
  datos   Json?

  /// Cuántas palabras tiene el capítulo escrito, y cuándo se guardó.
  ///
  /// El TEXTO no está aquí: vive en disco, porque esta base va en un plan
  /// compartido que ya pesa 171 MB. Aquí solo queda lo que hace falta para
  /// enseñarlo en el panel sin abrir un archivo por capítulo.
  palabras Int       @default(0)
  textoAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, skillCode])
  @@index([projectId, estado])
  @@map("project_stages")
}
