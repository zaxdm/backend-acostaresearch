# ── Servidor ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=debug

# ── Base de datos ─────────────────────────────────────────────────────────
#
# En producción es el MySQL de Clever Cloud. Su complemento limita las
# conexiones simultáneas (5 en el plan pequeño), y Prisma abre por su cuenta
# el doble de núcleos más una: sin `connection_limit` el servidor empieza a
# rechazar conexiones en cuanto hay algo de tráfico.
#
#   mysql://USUARIO:CLAVE@HOST:3306/BASE?connection_limit=3&pool_timeout=20&connect_timeout=15
#
# En desarrollo sin red vale el MySQL local de XAMPP.

DATABASE_URL="mysql://root@localhost:3306/acostaresearch"

# ── CORS (separar múltiples orígenes con coma) ────────────────────────────
CORS_ORIGIN=http://localhost:4200,https://acostaresearch.netlify.app
# Secreto compartido con el Worker de la web (wrangler secret put PROXY_SECRET).
# Con él, los límites por IP cuentan la del visitante y no la de Cloudflare.
# Mínimo 32 caracteres: openssl rand -base64 48
PROXY_SECRET=

# ── JWT ───────────────────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Genéralos con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# NUNCA reutilices estos dos entre entornos, y nunca los pegues aquí.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=acostaresearch-api
JWT_AUDIENCE=acostaresearch-web

# ── Cookies ───────────────────────────────────────────────────────────────
COOKIE_DOMAIN=
COOKIE_SECURE=false

# ── Verificación de email por código ─────────────────────────────────────────────────
EMAIL_VERIFICATION_TTL_MINUTES=15
# Base de los enlaces que viajan DENTRO de los correos (aviso de comprobante,
# pago aprobado, alerta de licencia). Es la dirección pública del frontend,
# no la del backend: un localhost aquí manda al comprador a su propio equipo.
APP_URL=https://acostaresearch.netlify.app

# ── Envío de correo (Brevo · SMTP) ────────────────────────────────────────
# La contraseña NO es la de tu cuenta: es una "SMTP key" de
# https://app.brevo.com/settings/keys/smtp
# Si SMTP_HOST o SMTP_PASS quedan vacíos, los correos se escriben en el log.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# El remitente debe estar dado de alta y validado como "sender" en Brevo.
#
# Que sea del dominio propio, NO un @gmail.com: Brevo firma con su dominio, no
# con el de Google, así que un remitente de Gmail nunca alinea DMARC y el correo
# acaba en spam aunque salga sin errores. Con el dominio autenticado en Brevo,
# la firma alinea y entra en la bandeja.
MAIL_FROM=no-responder@acostaresearch.com

# A dónde responde el tesista al darle a «Responder». Vacío = al remitente.
# Aquí sí vale un Gmail: es una cabecera de cortesía, no la identidad del envío,
# y ningún filtro la mira para decidir si el correo es legítimo.
MAIL_REPLY_TO=

# ── Datos iniciales (npm run db:seed) ─────────────────────────────────────
SEED_ADMIN_EMAIL=admin@example.com
# Sin valor, el sembrado usa una por defecto y lo avisa por consola. Defínela
# aquí en cualquier entorno que no sea tu equipo.
SEED_ADMIN_PASSWORD=

# ── Reescritor académico (Claude) ─────────────────────────────────────────
# Clave en https://console.anthropic.com/settings/keys · vacía = función desactivada
ANTHROPIC_API_KEY=
REWRITE_MODEL=claude-opus-5
REWRITE_EFFORT=high
REWRITE_MAX_WORDS_PER_REQUEST=3000
TRIAL_PLAN_CODE=PRUEBA

# ── Asistente Acosta (Gemini) ─────────────────────────────────────────────
# Clave en https://aistudio.google.com/apikey, en un proyecto CON facturación
# (en el nivel gratuito Google puede usar las conversaciones para entrenar).
# Vacía = el chat no aparece en la web.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Si el principal falla o está saturado. Vacío = sin respaldo.
GEMINI_MODEL_RESPALDO=gemini-3.1-flash-lite
GEMINI_THINKING=minimal
# Mensajes al día para todo el sitio. 0 = sin tope.
ASISTENTE_MAX_DIARIO=1500

# ── Preparar documento ───────────────────────────────────────────────────
# Edición de inglés académico, traducción y resúmenes. Usa la GEMINI_API_KEY de
# arriba: sin ella el servicio no se ofrece.
# Aquí sí el modelo bueno, al revés que en el chat: lo que sale es un Word por
# el que alguien pagó y que nadie revisa después.
PREPARAR_MODELO=gemini-3.8-flash
PREPARAR_MODELO_RESPALDO=gemini-3.5-flash
# Palabras por tanda y tandas a la vez. El proceso es uno y lo comparten todos.
PREPARAR_PALABRAS_POR_TANDA=900
PREPARAR_TANDAS_A_LA_VEZ=3
# Tope TÉCNICO, no comercial: la membresía es de tamaño libre.
PREPARAR_MAX_PALABRAS=60000
# Dónde van los .docx. Vacío = junto a los comprobantes, como los capítulos.
PREPARAR_DIR=

# ── Pasarela de pago (PayPal) ─────────────────────────────────────────────
# Credenciales de la app en https://developer.paypal.com/dashboard/applications
# Vacías = no hay pago en línea y la venta sigue siendo manual por Yape.
# PayPal NO admite soles: los planes se cobran en dólares (Plan.priceUsdCents).
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ── Pasarela de pago (Culqi) ──────────────────────────────────────────────
# Llaves del panel de Culqi (Desarrollo → API Keys). Tarjeta y Yape en soles.
# El prefijo decide el entorno: pk_test_/sk_test_ para pruebas, pk_live_/
# sk_live_ para cobrar de verdad. Las dos tienen que ser del mismo entorno.
# Vacías = Culqi no se ofrece; PayPal y el Yape manual siguen igual.
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=

# ── Conector MCP (licencias de las skills) ────────────────────────────────
# URL pública que el comprador pega en Claude. En producción DEBE ser https
# y estar accesible desde internet: Claude llama desde la nube de Anthropic.
MCP_PUBLIC_URL=http://localhost:3000/mcp
LICENSE_PRODUCT_CODE=METODO_9_SKILLS
# Días de vigencia de una licencia nueva. 0 = hasta que se revoque.
LICENSE_DURATION_DAYS=0

# Modo simulado del conector (solo desarrollo): responde sin llamar a Anthropic.
SKILLS_SIMULADAS=false

# ── Pago manual por Yape ──────────────────────────────────────────────────
# Titular y número que acompañan al QR del checkout. Vacíos = solo el QR.
YAPE_TITULAR=
YAPE_NUMERO=
# Destinatario del aviso de comprobante pendiente. Vacío = primer ADMIN activo.
ADMIN_NOTIFY_EMAIL=
# Dónde se guardan las capturas. Tiene que ser un disco persistente.
# PROOFS_DIR=./storage/comprobantes

# Enlace de contacto del pie de los correos. Vacío = no se muestra.
SUPPORT_WHATSAPP_URL=https://wa.me/51923095940

# ── Corpus bibliográfico (Zotero) ─────────────────────────────────────────
# El corpus se cura en Zotero y este servidor lo espeja para poder citarlo
# desde el conector sin depender de un tercero en cada llamada.
#
# LA CLAVE TIENE QUE SER DE SOLO LECTURA. Se crea en zotero.org/settings/keys
# dejando SIN marcar «Allow write access» y con los grupos en «Sólo lectura».
# Así, aunque se filtrara, nadie puede borrar ni alterar la biblioteca.
#
# Vacío = corpus apagado: el conector sigue sirviendo capítulos y no anuncia
# la herramienta de búsqueda de fuentes.
ZOTERO_API_KEY=
# El identificador NUMÉRICO de la cuenta (no el nombre de usuario).
ZOTERO_USER_ID=
# Solo si el corpus vive en una biblioteca de grupo. Con valor, manda sobre
# ZOTERO_USER_ID.
ZOTERO_GROUP_ID=

# ── Búsqueda abierta en OpenAlex ──────────────────────────────────────────
# Correo con el que el conector se identifica al buscar en OpenAlex. No es
# cortesía: sin él, OpenAlex atiende por la cola lenta y una búsqueda tarda lo
# bastante como para que el tesista crea que el conector se colgó.
#
# Vacío = se usa MAIL_FROM.
OPENALEX_MAILTO=
# Clave gratuita de https://openalex.org (cuenta → API key). HACE FALTA en
# producción: sin clave OpenAlex da diez centavos de presupuesto al día por IP,
# unas cien búsquedas para todos los tesistas juntos, y después rechaza todo
# hasta la medianoche UTC. Con clave, un dólar al día.
OPENALEX_API_KEY=

# --- Unpaywall (el enlace al PDF abierto) --------------------------------
# Correo con el que se identifica cada peticion, que es lo unico que Unpaywall
# pide: no hay clave ni registro. Se le pregunta solo por los DOI que OpenAlex
# no conoce todavia y como mucho por diez en cada busqueda, porque su API
# abierta no tiene consulta por lotes.
#
# Vacio = se usa OPENALEX_MAILTO, y si tampoco, MAIL_FROM.
UNPAYWALL_MAILTO=

# --- Scopus por API (Elsevier) -------------------------------------------
# APAGADO POR DEFECTO, Y NO ES PRUDENCIA DE MAS.
#
# El Acuerdo de Servicio de la API de Elsevier dice que la licencia se rige
# por el acuerdo entre Elsevier y "Your institution, company or organization",
# y prohibe dos cosas que este producto haria: almacenar contenido de Elsevier
# de forma sistematica, y dar acceso a ese contenido a terceros. Guardar
# fichas de Scopus en la biblioteca de cada comprador de un producto que se
# vende es justo eso.
#
# Registrar la clave en dev.elsevier.com es gratis y no arregla nada de lo
# anterior: da acceso tecnico, no permiso. Ponlo en true SOLO cuando exista
# por escrito el acuerdo con Elsevier que lo ampare. Ver docs/scopus-api.md.
#
# Con false: las rutas contestan "no disponible", la web no ensena el boton y
# la subida de exports RIS/CSV/BibTeX sigue funcionando igual que siempre.
SCOPUS_API_ENABLED=false

# La clave de dev.elsevier.com. Va en la cabecera X-ELS-APIKey y NUNCA sale
# de este servidor: ni al navegador, ni en una URL, ni en un log.
ELSEVIER_API_KEY=

# El token institucional, si Elsevier lo emite para esa clave.
#
# HACE MUCHA FALTA. Sin el, la clave se autentica POR LA IP de este servidor,
# que no pertenece a ninguna universidad suscrita: Elsevier devuelve la vista
# STANDARD, SIN RESUMEN, sin palabras clave y con un solo autor. Una ficha asi
# se puede citar, pero Claude no la va a encontrar cuando redacte.
#
# Lo pide la biblioteca de una institucion suscrita, indicando la clave.
# Elsevier lo puede revocar en cualquier momento y sin avisar.
ELSEVIER_INSTTOKEN=

# --- OAuth de Elsevier ----------------------------------------------------
# TODO ESTO ESTA PENDIENTE DE ELSEVIER. Su documentacion dice que ofrecen un
# OAuth para acceder a contenido "a nivel de usuario", pero NO publica los
# endpoints, ni los scopes, ni como registrar un client_id: el portal solo
# emite API Keys. Se pide escribiendo a apisupport@elsevier.com.
#
# Con esto vacio, "Conectar Scopus" conecta con la clave de la casa. En cuanto
# se rellene, el mismo boton pasa a mandar al tesista a autorizar en Elsevier
# y se guardan SUS tokens, cifrados con SECRETS_KEY. No hay que tocar codigo.
ELSEVIER_CLIENT_ID=
ELSEVIER_CLIENT_SECRET=
# Tiene que coincidir caracter por caracter con la que quede registrada en
# Elsevier. Vacio = <APP_URL>/api/v1/mi-scopus/vuelta, que es lo correcto
# salvo que Elsevier exija otra.
ELSEVIER_REDIRECT_URI=
# La pantalla de autorizacion y el canje del codigo. Los da Elsevier.
ELSEVIER_AUTH_URL=
ELSEVIER_TOKEN_URL=
# Los permisos que se piden, separados por espacios. Los da Elsevier.
ELSEVIER_SCOPE=

# ── El Mendeley de cada tesista (OAuth 2) ─────────────────────────────────
# Se registra la aplicacion una vez en https://dev.mendeley.com/myapps.html
# (ID y secreto). Alli se escribe la direccion de vuelta, que debe ser
# <APP_URL>/api/v1/mi-mendeley/vuelta salvo que se fije otra aqui abajo.
# Hace falta tambien SECRETS_KEY: los tokens se guardan cifrados.
# Vacio = "Conectar Mendeley" no se ofrece.
MENDELEY_CLIENT_ID=
MENDELEY_CLIENT_SECRET=
MENDELEY_REDIRECT_URI=

# Donde se guarda el texto de los capitulos que escribe cada tesista.
# Vacio = al lado de los comprobantes, que es lo correcto en produccion.
# No va en la base de datos: ver src/config/env.js.
CAPITULOS_DIR=

# ── Libro de Reclamaciones ────────────────────────────────────────────────
# Encabezan cada hoja, en la web y en los correos. El RUC son 11 dígitos;
# vacío = la hoja sale sin él, que el reglamento no da por completa.
RECLAMOS_RAZON_SOCIAL=Benicio Gonzalo Acosta Enríquez
RECLAMOS_RUC=
RECLAMOS_DOMICILIO=Trujillo, La Libertad, Perú
