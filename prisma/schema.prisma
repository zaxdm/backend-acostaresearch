// Esquema de autenticación — Acosta Research
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // El motor de consultas es un binario compilado para una arquitectura
  // concreta. "native" cubre el equipo donde se desarrolla (Windows x64) y el
  // segundo, el servidor: Ubuntu x86-64 con OpenSSL 3, que es lo que da un
  // Hetzner CX.
  //
  // Sin declararlo, el despliegue instala y compila sin una sola queja y luego
  // revienta en la primera consulta con un error sobre un motor que no
  // encuentra, sin decir que la causa es esta.
  //
  // Si el servidor pasara a ARM (línea CAX), cámbialo por
  // "linux-arm64-openssl-3.0.x".
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  EDITOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  /// La borró su dueño. La fila sigue ahí, vacía de datos personales, porque de
  /// ella cuelgan los pagos: borrarla de verdad se llevaría por delante las
  /// ventas, y una venta ocurrió aunque el comprador se vaya.
  DELETED
}

/// Cuentas reales: una fila aquí significa correo ya verificado.
/// El alta sin confirmar vive en `PendingRegistration`, no aquí.
model User {
  // MySQL no tiene tipo UUID nativo: se guarda como CHAR(36).
  id           String     @id @default(uuid()) @db.Char(36)
  email        String     @unique @db.VarChar(255)
  /// Nulo en las cuentas que entran con Google: ahí no hay contraseña que
  /// guardar, y un hash de relleno solo serviría para confundir.
  passwordHash String?    @db.VarChar(255)
  /// El `sub` de Google: identificador estable de la cuenta. El correo puede
  /// cambiar, esto no.
  googleId     String?    @unique @db.VarChar(64)
  firstName    String     @db.VarChar(80)
  lastName     String     @db.VarChar(80)
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)

  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  /// Cuándo pidió el dueño que se borrara. Nulo en una cuenta viva.
  deletedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens   RefreshToken[]
  rewrites        Rewrite[]
  wordPacks       WordPack[]
  payments        Payment[]
  licenses        License[]
  /// Las fuentes que subió de su propio export de Scopus. Se van con la cuenta.
  references      Reference[]
  accountCodes    AccountCode[]
  /// Su tesis, y su artículo si también lo compró. Ver `Project`.
  projects        Project[]
  /// Su Zotero, si lo conectó. Como mucho uno. Ver `ZoteroAccount`.
  zoteroAccount   ZoteroAccount?
  /// Su Mendeley, si lo conectó. Como mucho uno. Ver `MendeleyAccount`.
  mendeleyAccount MendeleyAccount?

  /// Su conexión con Scopus, si la tiene. Como mucho una. Ver `ScopusConnection`.
  scopusConnection ScopusConnection?
  /// Sus búsquedas guardadas y sus conversaciones con el copiloto de Scopus.
  scopusBusquedas  ScopusBusqueda[]

  /// Su membresía de «Preparar documento», si la compró, y los documentos que
  /// ha mandado preparar. Ver `DocPack` y `Preparacion`.
  docPacks      DocPack[]
  preparaciones Preparacion[]

  /// Enlace de prueba del que salió esta cuenta. Nulo en toda cuenta real.
  ///
  /// Con valor, NO es una persona registrada: es el titular de relleno de un
  /// conector de prueba, sin contraseña ni Google, con un correo que no existe.
  /// Hace falta porque todo lo del conector —la licencia, el proyecto, los
  /// capítulos guardados— cuelga de un usuario, y cada invitado necesita el
  /// suyo para no escribir en la tesis del de al lado. Ver `TrialLink`.
  ///
  /// En cascada: borrar el enlace se lleva a sus invitados y, con ellos, sus
  /// licencias y proyectos. No son clientes; no queda nada que conservar.
  trialLinkId String?    @db.Char(36)
  trialLink   TrialLink? @relation(fields: [trialLinkId], references: [id], onDelete: Cascade)

  @@index([trialLinkId])
  @@map("users")
}

/// Enlace de prueba del conector, para un grupo.
///
/// El administrador crea uno y lo comparte —en un taller, en un grupo de
/// WhatsApp—. Cada persona que lo abre recibe SU PROPIO conector de prueba, sin
/// registrarse, hasta agotar los cupos.
///
/// POR QUÉ NO ES UNA SOLA URL DE CONECTOR PARA TODOS
/// --------------------------------------------------
/// Porque se colapsa y se mezcla. El límite de ráfaga del conector va por token
/// —30 llamadas por minuto—, así que treinta personas sobre el mismo token se lo
/// comen en segundos. Y el proyecto de tesis cuelga del titular de la licencia:
/// con un solo titular, los treinta escribirían en la misma tesis. Tampoco hay
/// forma de separarlos después: Claude llama desde la infraestructura de
/// Anthropic y todas las peticiones llegan iguales, sea quien sea quien pregunta.
///
/// Va aparte de los códigos de activación a propósito: aquello es una venta o
/// una cortesía para una persona con cuenta, y esto no es ninguna de las dos.
/// No deja pagos, no entra en las cifras y sus conectores no se vigilan como
/// los de un comprador.
model TrialLink {
  id String @id @default(uuid()) @db.Char(36)

  /// Lo que va en la URL pública: /prueba/<slug>. Aleatorio: quien no tenga el
  /// enlace no puede adivinarlo y gastar los cupos.
  slug String @unique @db.VarChar(40)
  /// Para quién es: «Taller UNMSM». Solo lo ve el administrador… y el invitado
  /// en la página del enlace, que así sabe que ha llegado al sitio correcto.
  name String @db.VarChar(120)

  productCode String @db.VarChar(40)

  /// Cuántos conectores entrega, y cuántos lleva entregados.
  seats   Int @default(30)
  claimed Int @default(0)

  /// Ya no se lee: la duración va en `accessMinutes`. Se queda para que el
  /// despliegue que la sustituye no rompa nada mientras arranca el código nuevo.
  accessDays    Int @default(0)
  /// Cuánto dura la prueba, en minutos, desde `createdAt`. Pasada esa hora dejan
  /// de funcionar todos sus conectores y no entrega más.
  /// 0 = sin límite: el enlace no termina y se corta apagándolo.
  accessMinutes Int @default(0)

  /// Topes de cada conector. 0 = sin tope, como en las licencias.
  callsPerDay     Int @default(0)
  callsLimitTotal Int @default(0)

  /// Encendido o apagado. Apagado corta a la vez TODOS sus conectores y deja de
  /// entregar nuevos. Se comprueba al autenticar cada llamada, así que el corte
  /// es inmediato y volver a encenderlo los recupera tal como estaban.
  active Boolean @default(true)

  createdById String?  @db.Char(36)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guests User[]

  @@map("trial_links")
}

/// Refresh tokens rotativos.
/// Solo se guarda el hash SHA-256: si se filtra la BD, los tokens no son usables.
/// `familyId` agrupa toda la cadena de rotaciones de una sesión, de modo que al
/// detectar la reutilización de un token ya rotado se revoca la familia completa.
model RefreshToken {
  id        String @id @default(uuid()) @db.Char(36)
  tokenHash String @unique @db.Char(64)
  familyId  String @db.Char(36)

  userId String @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  userAgent String? @db.VarChar(255)
  ip        String? @db.VarChar(45)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Alta a medias: los datos del registro esperan aquí hasta que se acierta el
/// código. Solo entonces nace el `User`, así que la tabla de usuarios nunca
/// contiene cuentas sin verificar.
///
/// Del código se guarda su SHA-256, nunca el valor en claro. `attempts` frena la
/// fuerza bruta: 6 dígitos son adivinables sin un tope de intentos.
model PendingRegistration {
  id           String @id @default(uuid()) @db.Char(36)
  email        String @unique @db.VarChar(255)
  passwordHash String @db.VarChar(255)
  firstName    String @db.VarChar(80)
  lastName     String @db.VarChar(80)

  codeHash  String   @db.Char(64)
  attempts  Int      @default(0)
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pending_registrations")
}

/// Cada capítulo de una tesis se redacta con convenciones distintas; el
/// reescritor necesita saber en cuál está para no romperlas.
enum ThesisChapter {
  GENERAL
  CAP_I_PROBLEMA
  CAP_II_MARCO_TEORICO
  CAP_III_METODOLOGIA
  CAP_IV_RESULTADOS
  CAP_V_DISCUSION
  CAP_VI_CONCLUSIONES
  RESUMEN_ABSTRACT
}

enum RewriteStatus {
  COMPLETED
  FAILED
}

/// Nivel de intervención sobre el texto original.
enum RewriteMode {
  LIGERO // corrige y pule, respeta al máximo la redacción original
  ESTANDAR // reescribe para claridad y registro académico
  PROFUNDO // reorganiza la sintaxis y la progresión de las ideas
}

/// Una reescritura pedida por un usuario. Guarda el original y el resultado
/// para que el tesista pueda comparar y recuperar su historial, y el consumo
/// real de tokens para poder auditar el coste y aplicar la cuota.
model Rewrite {
  id     String @id @default(uuid()) @db.Char(36)
  userId String @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mode    RewriteMode   @default(ESTANDAR)
  chapter ThesisChapter @default(GENERAL)
  status  RewriteStatus

  sourceText  String  @db.MediumText
  resultText  String? @db.MediumText
  sourceWords Int

  model        String  @db.VarChar(60)
  inputTokens  Int     @default(0)
  outputTokens Int     @default(0)
  cachedTokens Int     @default(0)
  /// Coste estimado en USD con las tarifas del modelo usado.
  costUsd      Decimal @default(0) @db.Decimal(10, 6)

  errorCode  String? @db.VarChar(60)
  durationMs Int?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("rewrites")
}

/// Cómo sirve el conector el contenido de una licencia.
///
/// Es la decisión que define el producto, y tiene un precio en los dos
/// sentidos:
///
///   EXECUTED     — el servidor ejecuta la skill y devuelve el resultado. El
///                  método no sale nunca del servidor, pero cada consulta
///                  consume tokens de nuestra cuenta.
///
///   INSTRUCTIONS — el conector entrega las instrucciones y el trabajo lo hace
///                  el Claude del comprador. No cuesta un céntimo, pero el
///                  contenido llega a su equipo: se puede leer desplegando el
///                  resultado de la herramienta, y ninguna instrucción lo
///                  impide, porque para entonces ya llegó. Lo que sí queda es
///                  el control de acceso, la revocación y la trazabilidad.
enum McpDelivery {
  EXECUTED
  INSTRUCTIONS
}

/// Qué entrega un plan al pagarlo.
enum PlanKind {
  WORDS // una bolsa de palabras para el humanizador
  LICENSE // una licencia del conector MCP (el método de las 9 skills)
  DOCUMENTO // una membresía de «Preparar documento»: N documentos al mes
}

/// Lo que se vende: una bolsa de palabras que caduca a los N días.
/// Los precios se guardan en céntimos para no arrastrar errores de coma flotante.
model Plan {
  id           String  @id @default(uuid()) @db.Char(36)
  code         String  @unique @db.VarChar(40)
  name         String  @db.VarChar(80)
  description  String? @db.VarChar(255)
  words        Int
  priceCents   Int
  currency     String  @default("PEN") @db.VarChar(3)
  durationDays Int     @default(30)
  active       Boolean @default(true)
  sortOrder    Int     @default(0)

  /// Qué recibe el comprador. Un plan LICENSE ignora `words` y `durationDays`
  /// se aplica a la licencia en vez de a la bolsa.
  kind        PlanKind @default(WORDS)
  /// Para los planes LICENSE: qué producto se licencia.
  productCode String?  @db.VarChar(40)

  /// Topes del conector, por licencia. 0 = sin tope.
  ///
  /// El que de verdad protege el margen es el de coste: treinta llamadas al
  /// capítulo de Metodología cuestan varias veces más que treinta a
  /// Conclusiones, porque cada skill pesa distinto. Contar llamadas aproxima
  /// mal; contar dólares no.
  mcpCallsPerDay       Int @default(0)
  mcpCallsPerMonth     Int @default(0)
  mcpCostCentsPerMonth Int @default(0)
  /// Topes TOTALES, sin reinicio. Son los que hacen viable un acceso
  /// permanente: si el producto no caduca, un tope mensual no tiene fondo
  /// —doce meses cuestan doce veces el mes— y acaba costando más que la venta.
  /// El acceso es para siempre; el uso incluido, finito.
  mcpCallsTotal        Int @default(0)
  mcpCostCentsTotal    Int @default(0)

  /// Cómo se sirve el contenido. Ver `McpDelivery`.
  mcpDelivery McpDelivery @default(EXECUTED)

  /// Solo en los planes DOCUMENTO: cuántos documentos entrega al mes.
  ///
  /// «Al mes» y no «en total» a propósito: la mensual y la trimestral se
  /// diferencian SOLO en `durationDays` (30 y 90), y las dos dan diez al mes.
  /// Con un total, la trimestral habría que escribirla como treinta y quien
  /// tuviera prisa se los gastaría la primera semana. Ver `DocPack`.
  docsPorMes Int @default(0)

  /// PayPal no admite soles: para cobrar por ahí hace falta un precio en USD.
  /// Nulo = el plan no se puede comprar con las pasarelas que cobran en dólares
  /// (seguirá activándose a mano por Yape).
  priceUsdCents Int?

  /// Lo que costaba antes de la oferta, solo para enseñarlo tachado al lado del
  /// precio vigente. Nulo = no hay oferta y no se tacha nada.
  ///
  /// Lo que se cobra es SIEMPRE `priceCents`, aquí y en las pasarelas: este
  /// campo no entra en ningún cálculo. Rebajar consiste en bajar `priceCents`
  /// y dejar aquí el importe anterior, así que no puede pasar que la tarjeta
  /// anuncie una rebaja y el cobro salga por el precio viejo. Un valor que no
  /// supere al vigente no es una rebaja y no se guarda.
  listPriceCents Int?

  /// Plan «en prueba»: correos separados por coma que son los ÚNICOS que lo
  /// ven. Nulo = plan normal. Con correos no sale en la venta ni en el
  /// asistente, no se puede comprar y solo se emite a los administradores de
  /// la lista. Ver `billing/plan.visibilidad.js`.
  soloPara String? @db.VarChar(1000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  packs    WordPack[]
  payments Payment[]
  docPacks DocPack[]

  @@map("plans")
}

enum WordPackStatus {
  ACTIVE
  EXHAUSTED
  REVOKED
}

/// Una bolsa concreta comprada (o regalada) por un usuario.
/// La caducidad NO se guarda como estado: se compara `expiresAt` al consultarla,
/// así no hace falta ningún proceso que vaya marcando bolsas vencidas.
model WordPack {
  id String @id @default(uuid()) @db.Char(36)

  userId String @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId String @db.Char(36)
  plan   Plan   @relation(fields: [planId], references: [id])

  wordsTotal Int
  wordsUsed  Int            @default(0)
  status     WordPackStatus @default(ACTIVE)

  activatedAt DateTime @default(now())
  expiresAt   DateTime

  /// Trazabilidad del cobro manual: quién pagó, por dónde y con qué operación.
  paymentMethod String? @db.VarChar(30)
  paymentRef    String? @db.VarChar(80)
  amountCents   Int?
  note          String? @db.VarChar(255)

  /// Administrador que la activó. Null si la dio el sistema (prueba gratuita).
  grantedById String? @db.Char(36)

  createdAt DateTime @default(now())

  /// Cobro que la originó, si vino de una pasarela.
  payment Payment?

  @@index([userId, status, expiresAt])
  @@map("word_packs")
}

/// Estados de un cobro. No hay "reembolsado" todavía: cuando haga falta se
/// añade aquí y se refleja revocando la bolsa correspondiente.
enum PaymentStatus {
  PENDING // orden creada en la pasarela; el usuario aún no ha pagado nada
  IN_REVIEW // pago manual con comprobante enviado, a la espera de que el administrador lo mire
  PAID // cobro confirmado y bolsa entregada
  FAILED // la pasarela rechazó el cobro o devolvió algo que no cuadra
  REJECTED // el administrador revisó el comprobante y no lo dio por bueno
  CANCELLED // el usuario cerró la ventana sin llegar a pagar
}

/// Un intento de compra a través de una pasarela.
///
/// La fila se crea ANTES de cobrar, con el importe que nosotros calculamos a
/// partir del plan: al confirmar, se compara con lo que devuelve la pasarela y
/// solo se entrega la bolsa si coincide. Así el importe nunca lo decide el
/// navegador.
///
/// `provider` es texto y no un enum a propósito: añadir Culqi o Mercado Pago no
/// debe obligar a una migración de base de datos.
model Payment {
  id String @id @default(uuid()) @db.Char(36)

  userId String @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId String @db.Char(36)
  plan   Plan   @relation(fields: [planId], references: [id])

  provider          String        @db.VarChar(20)
  /// Identificador de la orden en la pasarela (en PayPal, el `orderID`).
  providerOrderId   String        @db.VarChar(120)
  /// Identificador del cobro ya efectuado, que es el que sirve para conciliar.
  providerCaptureId String?       @db.VarChar(120)
  status            PaymentStatus @default(PENDING)

  /// Importe esperado, en céntimos de `currency` (la moneda de la pasarela,
  /// que no tiene por qué ser la del plan).
  amountCents Int
  currency    String @db.VarChar(3)

  /// Lo entregado al confirmar el cobro. Solo uno de los tres, según el plan.
  wordPackId String?   @unique @db.Char(36)
  wordPack   WordPack? @relation(fields: [wordPackId], references: [id])
  /// La membresía de «Preparar documento». SIN `@unique`, por lo mismo que la
  /// licencia: renovar alarga la que ya tiene en vez de abrir otra, y con
  /// `@unique` la segunda renovación chocaría contra la primera.
  docPackId  String?   @db.Char(36)
  docPack    DocPack?  @relation(fields: [docPackId], references: [id])
  /// SIN `@unique`, a propósito: una licencia la paga su compra y después
  /// cada renovación, que alarga la misma licencia en vez de emitir otra. Con
  /// `@unique` la segunda chocaba contra la primera y ninguna renovación se
  /// podía cobrar (el 19-sep-2026 un Yape de renovación daba «El registro ya
  /// existe» al aprobarlo).
  licenseId  String?   @db.Char(36)
  license    License?  @relation(fields: [licenseId], references: [id])

  /// Descuento aplicado, si el comprador usó un código promocional.
  discountCodeId String?       @db.Char(36)
  discountCode   DiscountCode? @relation(fields: [discountCodeId], references: [id])
  /// Rebaja en céntimos de la moneda del cobro, ya restada de `amountCents`.
  discountCents  Int           @default(0)

  payerEmail  String? @db.VarChar(255)
  errorCode   String? @db.VarChar(60)
  /// Respuesta cruda de la pasarela, para poder reclamar con pruebas.
  rawResponse String? @db.MediumText

  /// ── Pago manual (Yape o transferencia) ──────────────────────────────────
  /// Ruta del comprobante en disco, relativa al directorio de comprobantes. La
  /// imagen NO se guarda en la base de datos: son capturas de pantalla de un
  /// megabyte largo y aquí solo estorban a cada consulta de la tabla.
  proofPath     String?   @db.VarChar(255)
  proofMime     String?   @db.VarChar(40)
  /// Número de operación que muestra Yape. Es lo que permite cuadrar el
  /// comprobante con el extracto real sin fiarse de la captura.
  operationCode String?   @db.VarChar(40)
  /// Quién revisó el comprobante y qué decidió. Como el `createdById` de los
  /// códigos, va sin relación: es un apunte de auditoría, no algo que se
  /// navegue desde el usuario.
  reviewedById  String?   @db.Char(36)
  reviewedAt    DateTime?
  /// Motivo del rechazo. Se le enseña al comprador tal cual, así que se
  /// escribe pensando en que lo va a leer él.
  reviewNote    String?   @db.VarChar(255)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  paidAt    DateTime?

  @@unique([provider, providerOrderId])
  @@index([licenseId])
  @@index([docPackId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Licencias del conector MCP
// ─────────────────────────────────────────────────────────────────────────────

enum ActivationCodeStatus {
  AVAILABLE // generado y aún sin canjear
  REDEEMED // ya se cambió por una licencia
  VOID // anulado a mano antes de usarse
}

/// Código de un solo uso que se entrega al comprador tras la venta.
///
/// Se guarda solo su SHA-256, igual que los refresh tokens: si se filtra la
/// base de datos, los códigos no son canjeables. Como consecuencia, el código
/// en claro se ve UNA vez —al generarlo— y nunca más; por eso se guarda `hint`,
/// que permite reconocerlo en el panel sin poder reconstruirlo.
model ActivationCode {
  id       String @id @default(uuid()) @db.Char(36)
  codeHash String @unique @db.Char(64)
  hint     String @db.VarChar(12)

  /// Qué se está vendiendo. Permite tener varios productos con el mismo motor.
  productCode String               @db.VarChar(40)
  status      ActivationCodeStatus @default(AVAILABLE)

  buyerEmail String? @db.VarChar(255)
  note       String? @db.VarChar(255)

  /// El cobro que hubo detrás, cuando el dinero entró fuera de la web.
  ///
  /// Un código se reparte por dos motivos distintos y la diferencia importa:
  /// puede ser una venta cobrada por Western Union, transferencia o un Yape que
  /// llegó al WhatsApp, o puede ser una cortesía. Sin estos campos las dos
  /// entregaban lo mismo y ninguna dejaba rastro del dinero, así que esas ventas
  /// no existían en las cifras del panel.
  ///
  /// Se apunta aquí, al generar, y no al canjear: quien sabe cuánto se cobró y
  /// por dónde es el administrador en el momento de la venta. El pago se crea
  /// después, al canjear, porque hasta entonces no hay cuenta a la que colgarlo.
  ///
  /// `paymentMethod` nulo o CORTESIA = regalo: no se registra ningún cobro.
  paymentMethod String? @db.VarChar(30)
  /// Nº de operación o MTCN, para cuadrarlo contra el extracto real.
  paymentRef    String? @db.VarChar(80)
  amountCents   Int?

  /// Comprobante de la venta, si el administrador guardó uno. Opcional a
  /// propósito: una cortesía no tiene captura y una transferencia que ya se vio
  /// en el extracto tampoco la necesita.
  ///
  /// Como en los pagos por Yape, la imagen va a disco y aquí solo queda su
  /// ruta: pesa uno o dos megabytes y dentro de una tabla que se lista entera
  /// en el panel solo estorbaría.
  proofPath String? @db.VarChar(255)
  proofMime String? @db.VarChar(40)

  createdById  String?   @db.Char(36)
  redeemedById String?   @db.Char(36)
  redeemedAt   DateTime?
  /// Caducidad del código sin canjear. Nula = no caduca.
  expiresAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  license License?

  @@index([productCode, status])
  @@map("activation_codes")
}

enum LicenseStatus {
  ACTIVE
  SUSPENDED // parada temporalmente, se puede reactivar
  REVOKED // cancelada; el token no vuelve a servir
}

/// El acceso vivo de un comprador al conector MCP.
///
/// El token viaja dentro de la URL del conector, así que el comprador lo ve.
/// Se guarda hasheado de todos modos: el objetivo no es ocultárselo a él, sino
/// que una filtración de la base de datos no entregue todas las licencias.
model License {
  id String @id @default(uuid()) @db.Char(36)

  userId String @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productCode String        @db.VarChar(40)
  tokenHash   String        @unique @db.Char(64)
  /// Primeros caracteres del token, para identificarla en el panel.
  tokenHint   String        @db.VarChar(12)
  status      LicenseStatus @default(ACTIVE)

  activationCodeId String?         @unique @db.Char(36)
  activationCode   ActivationCode? @relation(fields: [activationCodeId], references: [id])

  /// Contadores acumulados: el motor de detección compara el uso de hoy contra
  /// el histórico del propio comprador, que es la señal que sí se sostiene.
  callsTotal Int       @default(0)
  lastUsedAt DateTime?

  /// Topes copiados del plan al comprar. Se guardan aquí y no se leen del plan
  /// cada vez a propósito: subir o bajar el precio de un plan no debe cambiar
  /// lo que compró alguien el mes pasado.
  callsPerDay         Int @default(0)
  callsPerMonth       Int @default(0)
  costCentsPerMonth   Int @default(0)
  callsLimitTotal     Int @default(0)
  costCentsLimitTotal Int @default(0)

  /// Copiado del plan al emitirla, como los topes.
  delivery McpDelivery @default(EXECUTED)

  /// Última vez que el motor de detección la revisó. Evita recalcular treinta
  /// días de historial en cada llamada.
  lastCheckedAt DateTime?

  revokedAt      DateTime?
  revokedReason  String?   @db.VarChar(255)
  /// Cuándo la reactivó el administrador por última vez.
  ///
  /// La vigilancia no juzga nada anterior a esta fecha: ni el uso, ni las
  /// alertas, ni el aviso previo. Sin ella, reactivar no servía: la siguiente
  /// pasada volvía a ver las mismas conversaciones que la revocaron y el mismo
  /// aviso de días atrás, y la revocaba otra vez en cuanto se usaba.
  reactivatedAt  DateTime?
  /// Si quien la tiene puede abrir más de una tesis de este método desde su
  /// panel. Lo enciende un administrador desde la ficha del acceso; por defecto,
  /// una tesis por licencia, que es lo que se vende.
  variasTesis    Boolean   @default(false)
  /// Caducidad del acceso. Nula = mientras no se revoque.
  expiresAt      DateTime?
  /// Cuándo se avisó al comprador de que su acceso estaba por caducar. Guarda
  /// la fecha y no un booleano para que se vea, meses después, si el aviso
  /// salió a tiempo o el día antes.
  expiryWarnedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usages   LicenseUsage[]
  alerts   LicenseAlert[]
  sessions McpSession[]
  counter  LicenseCounter?
  /// Los cobros que la pagaron: la compra y cada renovación. Vacío si se
  /// canjeó con un código.
  payments Payment[]

  @@index([userId, status])
  @@map("licenses")
}

/// Una llamada al conector. Es la materia prima del motor de detección.
///
/// NO se guarda la IP del comprador porque no existe: Claude llama desde la
/// infraestructura de Anthropic, así que todas las peticiones llegan del mismo
/// rango de direcciones sea quien sea el que pregunta. Lo que sí distingue a un
/// token compartido es el volumen frente a su propio histórico, el solapamiento
/// de llamadas y la incoherencia entre consultas seguidas.
model LicenseUsage {
  id String @id @default(uuid()) @db.Char(36)

  licenseId String  @db.Char(36)
  license   License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  tool       String  @db.VarChar(60)
  /// SHA-256 del texto de la consulta. Permite comparar si dos llamadas
  /// seguidas hablan de lo mismo sin conservar lo que escribió el tesista.
  promptHash String? @db.Char(64)
  /// Sesión declarada por el cliente, cuando la hay: dos sesiones distintas
  /// vivas a la vez sobre el mismo token es la señal más difícil de disimular.
  sessionId  String? @db.VarChar(64)

  ok         Boolean   @default(true)
  durationMs Int?
  kind       UsageKind @default(NORMAL)

  /// Consumo real de la llamada. Es lo que se compara contra el tope de gasto,
  /// y lo que permite saber de verdad cuánto cuesta cada capítulo.
  inputTokens  Int @default(0)
  outputTokens Int @default(0)
  cachedTokens Int @default(0)
  costCents    Int @default(0)

  createdAt DateTime @default(now())

  @@index([licenseId, createdAt])
  @@map("license_usages")
}

/// Una de las skills del método, tal como la ve el conector.
///
/// El contenido NO está aquí: vive en el bundle `.skill` y, una vez subido, en
/// la Skills API de Anthropic. Esta tabla solo guarda qué existe, cómo se llama
/// de cara al comprador y con qué identificador invocarla.
model Skill {
  id    String @id @default(uuid()) @db.Char(36)
  /// El `name` del frontmatter del SKILL.md. Es la clave estable.
  code  String @unique @db.VarChar(64)
  orden Int

  /// En qué grupos aparece. Ver `SkillGroup`.
  ///
  /// Sin ninguna fila = visible para cualquier licencia. No es la vía normal,
  /// pero evita que una skill subida sin elegir grupo desaparezca en silencio:
  /// es más fácil de detectar un capítulo que se ve de más que uno que no se ve.
  groups SkillGroup[]

  displayName String @db.VarChar(120)
  /// Resumen para el catálogo. Es lo ÚNICO del contenido que ve el comprador.
  summary     String @db.VarChar(500)
  bundlePath  String @db.VarChar(255)

  /// Identificadores en la Skills API. Nulos mientras no se haya subido.
  anthropicSkillId   String? @db.VarChar(80)
  anthropicVersionId String? @db.VarChar(80)

  /// Tamaño del SKILL.md, para vigilar el coste por invocación.
  skillMdBytes Int @default(0)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("skills")
}

/// En qué grupos aparece un capítulo.
///
/// UNA SKILL PUEDE ESTAR EN VARIOS GRUPOS A LA VEZ
/// -----------------------------------------------
/// Antes esto era una columna `productCode` en `skills`, es decir, un capítulo
/// pertenecía a un grupo y solo a uno. Y eso no describe el negocio: «Tema y
/// delimitación» es el primer capítulo del método de tesis Y del pack de tesis
/// con humanizador. Con una columna, meterlo en el segundo lo sacaba del
/// primero sin avisar, y el grupo de al lado se quedaba sin capítulo.
///
/// El orden se queda en `Skill.orden`, no aquí: los grupos que comparten
/// capítulos comparten también la secuencia del método, que es justo por lo que
/// los comparten.
model SkillGroup {
  skillId String @db.Char(36)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  /// El `productCode` del plan que vende ese grupo. No es una clave foránea
  /// porque el plan se identifica por `code` y varios planes pueden compartir
  /// `productCode`: lo que se comprueba, en el servicio, es que exista alguno.
  productCode String @db.VarChar(40)

  createdAt DateTime @default(now())

  @@id([skillId, productCode])
  @@index([productCode])
  @@map("skill_groups")
}

/// Contadores del conector, uno por licencia.
///
/// Existe para que comprobar el límite sea una sola lectura por id, en vez de
/// contar filas de `license_usages` en cada llamada.
///
/// El reinicio no necesita ningún proceso programado: se guarda el día y el mes
/// en curso como texto, y si el sello no coincide con hoy, el contador vale
/// cero. Un servidor apagado una semana vuelve con las cuentas correctas.
model LicenseCounter {
  licenseId String  @id @db.Char(36)
  license   License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  callsToday     Int @default(0)
  callsMonth     Int @default(0)
  costCentsToday Int @default(0)
  costCentsMonth Int @default(0)

  /// Acumulados desde el primer día y sin reinicio: se comparan contra los
  /// topes totales. Solo suman las llamadas que de verdad se sirvieron.
  callsLifetime     Int @default(0)
  costCentsLifetime Int @default(0)

  /// Sellos en hora de Lima: el día del comprador, no el del servidor.
  dayStamp   String @db.VarChar(10)
  monthStamp String @db.VarChar(7)

  updatedAt DateTime @updatedAt

  @@map("license_counters")
}

/// Qué clase de llamada fue. Alimenta tanto los límites como la detección.
enum UsageKind {
  NORMAL // consulta legítima
  EXTRACTION_ATTEMPT // intento de sacar las instrucciones internas
  BLOCKED_LIMIT // rechazada por haber agotado el tope
}

enum AlertKind {
  VOLUMEN
  SESIONES_SOLAPADAS
  CONSULTAS_INCOHERENTES
  EXTRACCION
}

enum AlertLevel {
  ALERTA
  SOSPECHA_ALTA
}

enum AlertAction {
  NINGUNA
  NOTIFICADO
  REVOCADO
}

/// Lo que el motor de detección encontró, guardado en vez de recalculado.
///
/// Hace falta que quede escrito por dos razones: para que la regla de "a la
/// segunda se revoca" tenga memoria, y para poder explicarle a un comprador
/// por qué se le cortó el acceso.
model LicenseAlert {
  id String @id @default(uuid()) @db.Char(36)

  licenseId String  @db.Char(36)
  license   License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  kind   AlertKind
  level  AlertLevel
  action AlertAction @default(NINGUNA)

  /// Las métricas que la dispararon, para poder revisarla meses después.
  detalle String? @db.VarChar(500)

  createdAt DateTime @default(now())

  @@index([licenseId, createdAt])
  @@map("license_alerts")
}

/// Código promocional que rebaja el precio de una compra.
///
/// A diferencia de `ActivationCode`, este SÍ se guarda en claro: no es una
/// credencial que dé acceso a nada, sino una rebaja, y el administrador
/// necesita releerlo para reenviárselo a un cliente o publicarlo.
///
/// La rebaja se define en céntimos de SOL, que es la moneda en la que se
/// anuncian los precios. Al cobrar en dólares se traslada la misma proporción,
/// para que el descuento anunciado y el cobrado coincidan.
model DiscountCode {
  id   String @id @default(uuid()) @db.Char(36)
  code String @unique @db.VarChar(40)

  amountCents Int

  /// Plan al que se limita. Nulo = vale para cualquiera.
  planCode String? @db.VarChar(40)

  /// Cuántas veces puede canjearse en total. 0 = sin límite.
  maxUses   Int @default(0)
  usedCount Int @default(0)

  active    Boolean   @default(true)
  expiresAt DateTime?
  note      String?   @db.VarChar(255)

  /// Si se anuncia en la página de precios, junto a su plan.
  ///
  /// NACE EN FALSO Y SE PUBLICA A PROPÓSITO. Un código de campaña que se
  /// reparte en TikTok y uno negociado con una persona concreta se guardan
  /// igual y se resuelven igual; lo único que los distingue es esto. Con el
  /// valor por defecto al revés, cualquier código creado con prisa acabaría
  /// anunciado en la portada.
  publico Boolean @default(false)

  createdById String?  @db.Char(36)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments Payment[]

  @@index([active, expiresAt])
  @@map("discount_codes")
}

/// Una conversación abierta con una skill a través del conector.
///
/// Las skills del método CONVERSAN: preguntan, esperan respuesta y avanzan por
/// pasos. Una llamada a una herramienta MCP es de un solo tiro, así que el hilo
/// tiene que vivir aquí: el cliente manda un identificador y el servidor
/// recupera lo hablado.
model McpSession {
  id String @id @default(uuid()) @db.Char(36)

  licenseId String  @db.Char(36)
  license   License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  skillCode String @db.VarChar(64)
  /// Identificador que elige el cliente para su hilo.
  clientKey String @db.VarChar(64)

  /// La conversación, en el formato de la Messages API.
  messages String @db.LongText

  /// Contenedor de ejecución que se reutiliza entre turnos: dentro viven los
  /// .docx que va generando la skill. Caduca solo, y entonces se empieza otro.
  containerId String?   @db.VarChar(120)
  expiresAt   DateTime?

  turns       Int @default(0)
  /// Último tramo del método entregado, en las licencias de entrega.
  /// Permite servir el paso siguiente sin que el cliente lleve la cuenta.
  lastSection Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Un cliente no puede tener dos hilos con la misma clave.
  @@unique([licenseId, clientKey])
  @@index([licenseId, updatedAt])
  @@map("mcp_sessions")
}

/// Código de un solo uso para confirmar un cambio delicado en una cuenta que YA
/// existe: hoy, cambiar la contraseña.
///
/// No se reutiliza `PendingRegistration` porque no es lo mismo: allí el usuario
/// todavía no existe y la fila ES el alta a medias. Aquí la cuenta existe, el
/// código solo autoriza una operación, y al gastarse desaparece.
///
/// La pareja (usuario, propósito) es única: pedir otro código sustituye al
/// anterior en vez de dejar varios vivos. Un código viejo que siga valiendo es
/// exactamente lo que no se quiere de una cosa que se manda por correo.
model AccountCode {
  id String @id @default(uuid()) @db.Char(36)

  userId String @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Qué autoriza al acertarlo. Hoy solo PASSWORD.
  purpose String @db.VarChar(30)

  codeHash String @db.Char(64)
  /// Fallos seguidos. Al llegar al tope el código muere y hay que pedir otro.
  attempts Int    @default(0)

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, purpose])
  @@map("account_codes")
}

/// Una fuente bibliográfica del corpus de la casa.
///
/// El corpus se cura en Zotero, no aquí: allí está el conector del navegador
/// que captura una ficha de Scopus o de Scielo en un clic, y el editor con el
/// que se corrige un autor mal puesto. Esta tabla es un espejo de solo lectura.
///
/// POR QUÉ SE ESPEJA EN VEZ DE CONSULTAR ZOTERO EN VIVO
/// ----------------------------------------------------
/// El límite de peticiones de Zotero es por cuenta, y la cuenta es UNA para
/// todos los clientes a la vez: un día bueno de ventas bloquearía a todos. Y
/// una consulta en vivo mete a un tercero dentro de cada turno de Claude, así
/// que un rato lento de Zotero es un rato lento del producto, y una caída suya
/// es una caída nuestra. Sincronizar es barato —la API devuelve solo lo que
/// cambió— y deja al conector leyendo de la misma base que todo lo demás.
model Reference {
  id String @id @default(uuid()) @db.Char(36)

  /// La clave con la que se cita esta fuente: AR + ocho caracteres.
  ///
  /// La CALCULA MySQL a partir de `id`, y por eso ninguna vía de entrada tiene
  /// que acordarse de rellenarla. Nunca se escribe desde aquí; si algún día se
  /// intentara, la base lo rechaza.
  ref String? @unique @db.VarChar(12)

  /// La clave del ítem en Zotero. Es la identidad de la fuente EN EL FONDO DE
  /// LA CASA: al sincronizar se actualiza por ella, de modo que corregir una
  /// ficha en Zotero corrige la fila y no crea una segunda.
  ///
  /// NULA en lo que sube un comprador desde Scopus: eso no viene de Zotero y no
  /// tiene clave que traer. MySQL admite tantos nulos como quiera en un índice
  /// único, así que la columna sigue siendo única para las que sí la tienen y
  /// no estorba a las que no. Esa es toda la migración que hizo falta.
  zoteroKey String? @unique @db.VarChar(16)
  /// Versión del ítem en Zotero, para pedir solo lo modificado. 0 en lo importado.
  version   Int

  /// De quién es esta fuente.
  ///
  /// NULA = del fondo de la casa, que es lo que ven todas las licencias. Con
  /// valor, es de ese comprador y NO LA VE NADIE MÁS. Es el filtro que no puede
  /// fallar: un descuido aquí enseña el material de un tesista a otro.
  ///
  /// Va en la fila y no como etiqueta a propósito. El export de Scopus lo
  /// descargó él con la suscripción de su universidad: es suyo, se borra con su
  /// cuenta, y no se funde con el corpus que se sirve a los demás.
  ownerUserId String? @db.Char(36)
  owner       User?   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  /// De dónde salió: ZOTERO (la casa o su Zotero), SCOPUS (subida por un
  /// comprador) o MENDELEY (su Mendeley conectado).
  ///
  /// Se guarda porque cambia lo que se le dice al asistente: lo de la casa lleva
  /// la nota de Acosta y lo importado no, y esa diferencia tiene que llegarle al
  /// conector para que no las presente como si fueran lo mismo.
  origin ReferenceOrigin @default(ZOTERO)

  /// Identidad de una fuente importada: su DOI, o el EID de Scopus, o el título
  /// normalizado si no trae ninguno de los dos. Nula en el fondo de la casa,
  /// que se identifica por su clave de Zotero.
  ///
  /// Junto con el dueño forma la clave que evita duplicados: volver a subir el
  /// mismo export no crea una segunda copia de nada.
  sourceRef String? @db.VarChar(200)

  itemType String  @db.VarChar(40)
  title    String  @db.VarChar(500)
  /// Autores ya formateados: «Hernández, R.; Fernández, C.».
  authors  String  @db.VarChar(500)
  year     Int?
  /// Revista, libro, congreso o editorial, según el tipo de fuente.
  source   String? @db.VarChar(300)

  /// Volumen, número y páginas: «15», «2», «45-62».
  ///
  /// Texto y no números. Un volumen puede ser «15A», un número «S1» y las
  /// páginas de un artículo electrónico «e0123456»: guardarlos como enteros
  /// obliga a inventar una regla para cada revista rara.
  ///
  /// Sin estos tres, una referencia de revista NO está completa en APA, y es
  /// de lo primero que mira un asesor. Se rellenan desde donde vengan —Zotero,
  /// el export, OpenAlex— y lo que falte se completa por DOI contra Crossref,
  /// que es el registro donde el editor los depositó.
  volume   String? @db.VarChar(40)
  issue    String? @db.VarChar(40)
  pages    String? @db.VarChar(40)
  doi      String? @db.VarChar(200)
  url      String? @db.VarChar(500)
  abstract String? @db.Text

  /// Las notas del ítem, unidas y sin etiquetas HTML.
  ///
  /// Vale más que el resumen: el resumen lo escribió la revista para vender su
  /// artículo, y la nota la escribió Acosta diciendo para qué sirve esta fuente
  /// y qué afirmación respalda.
  notes String? @db.Text

  /// Las etiquetas de Zotero, separadas por coma. Se guardan como texto porque
  /// se muestran; el filtro por producto NO se hace aquí, sino en `groups`.
  tags String @default("") @db.VarChar(500)

  /// Título, autores, resumen, notas y etiquetas en minúsculas y sin tildes.
  ///
  /// Una sola columna para buscar. Con un corpus de cientos de fuentes —no de
  /// millones— un LIKE sobre este campo responde de sobra, y evita depender de
  /// los índices de texto completo, que en Prisma siguen tras una bandera.
  busqueda String @db.Text

  groups ReferenceGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerUserId, sourceRef])
  @@index([ownerUserId])
  @@index([year])
  @@map("references")
}

/// De dónde salió una fuente. Ver el campo `origin` de `Reference`.
enum ReferenceOrigin {
  /// La biblioteca curada de la casa, espejada desde Zotero. Lleva nota.
  ZOTERO
  /// Un export que subió un comprador. Trae resumen, no lleva nota.
  SCOPUS
  /// Lo que trajo un comprador de SU Mendeley conectado. Ver `MendeleyAccount`.
  ///
  /// Valor propio y no SCOPUS, al revés que la API de Scopus: al tesista SÍ le
  /// importa distinguirlo —«muéstrame lo de Mendeley»— y la limpieza de lo que
  /// sacó de su carpeta tiene que poder acotarse a lo que vino de allí.
  MENDELEY
}

/// A qué productos pertenece una fuente. Mismo trato que `SkillGroup`.
///
/// SIN NINGUNA FILA = VISIBLE PARA TODOS, y aquí eso no es un caso raro sino lo
/// habitual: la metodología —Hernández Sampieri, Creswell, las normas APA—
/// sirve igual a quien escribe una tesis que a quien manda un artículo a una
/// revista. Solo se etiqueta lo que de verdad pertenece a una ruta.
model ReferenceGroup {
  referenceId String    @db.Char(36)
  reference   Reference @relation(fields: [referenceId], references: [id], onDelete: Cascade)

  /// El `productCode` del plan, igual que en `skill_groups`. No es clave
  /// foránea por la misma razón que allí.
  productCode String @db.VarChar(40)

  createdAt DateTime @default(now())

  @@id([referenceId, productCode])
  @@index([productCode])
  @@map("reference_groups")
}

/// Marcador de la última sincronización. Una sola fila, siempre la 1.
///
/// Guarda la versión de la biblioteca, no la fecha: Zotero versiona la
/// biblioteca entera con un número que crece, y pedir `?since=<esa versión>`
/// devuelve exactamente lo que cambió desde entonces, borrados incluidos. Con
/// una fecha habría que traerlo todo y comparar.
model ReferenceSync {
  id             Int       @id @default(1)
  libraryVersion Int       @default(0)
  lastRunAt      DateTime?
  /// Cuántas fuentes quedaron tras la última pasada. Es lo que enseña el panel.
  lastCount      Int       @default(0)
  /// Cerrojo entre procesos: cuándo entró quien está sincronizando ahora mismo.
  /// Nulo = no hay nadie dentro. Lo toma un UPDATE condicional, que es atómico,
  /// así que el panel y la tarea nocturna no pueden solaparse. Guarda la hora y
  /// no un sí/no para poder soltarlo si el proceso murió a media pasada.
  runningSince   DateTime?

  @@map("reference_sync")
}

/// Un video de la página de tutoriales.
///
/// Vive en la base y no en el código por una razón práctica: quien graba los
/// videos no despliega. Tenerlos escritos en un archivo obligaba a editar
/// TypeScript y empujar a git para publicar una URL de YouTube, que es pedirle
/// a alguien que aprenda git para hacer su trabajo.
///
/// Todo lo que se ve en la tarjeta se edita desde el panel: el título, la
/// duración, el texto y los puntos. Los puntos son texto con un salto de línea
/// por punto, no JSON, porque se escriben en un cuadro de texto normal y a nadie
/// le apetece cerrar corchetes para añadir una viñeta.
model Tutorial {
  id String @id @default(uuid()) @db.Char(36)

  /// En qué orden salen. Tienen orden de verdad: el primero se ve una vez y el
  /// segundo es el que hay que ver.
  orden Int

  /// El bloque en el que sale en la lista: «Para empezar», «Una por Skill».
  /// Los videos seguidos con el mismo grupo van juntos bajo ese rótulo.
  grupo    String @default("") @db.VarChar(60)
  /// Lo que va en el círculo en lugar del número, como «S4». Vacío = su número.
  etiqueta String @default("") @db.VarChar(8)

  titulo   String @db.VarChar(160)
  /// «5 min». Para que se sepa si hay tiempo de verlo ahora o hay que dejarlo.
  duracion String @db.VarChar(24)
  /// Qué problema resuelve, en una o dos frases.
  entrada  String @db.VarChar(600)
  /// Lo que se ve, un punto por línea. Es también el guion de la grabación.
  puntos   String @db.Text

  /// Enlace de YouTube. VACÍO = todavía no está grabado, y la tarjeta lo dice
  /// en lugar de dejar un hueco negro.
  videoUrl String @default("") @db.VarChar(500)

  /// Apagado se queda fuera de la página pública pero no se pierde. Sirve para
  /// retirar un video que quedó viejo —la interfaz de Claude cambia— mientras
  /// se regraba, en vez de borrarlo y volver a escribirlo todo.
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orden])
  @@map("tutorials")
}

/// Las guías en PDF de la página de guías (instalación del conector y demás).
/// El archivo vive en disco, en GUIAS_DIR, como `<id>.pdf`; aquí solo su ficha.
model Guia {
  id String @id @default(uuid()) @db.Char(36)

  orden       Int    @default(1)
  titulo      String @db.VarChar(160)
  /// Qué trae, en una o dos frases.
  descripcion String @default("") @db.VarChar(600)

  /// Cómo se llamaba el archivo subido y cuánto pesa. Vacío = sin PDF todavía.
  archivoNombre String @default("") @db.VarChar(200)
  bytes         Int    @default(0)

  /// Apagada se queda fuera de la página pública pero no se pierde.
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orden])
  @@map("guias")
}

// ─────────────────────────────────────────────────────────────────────────────
// El proyecto del tesista
// ─────────────────────────────────────────────────────────────────────────────

/**
 * En qué punto está una etapa.
 * Solo tres, y el salto de EN_CURSO a LISTO lo da el tesista, no el asistente.
 * Que un capítulo se dé por bueno solo porque se escribió mucho es exactamente
 * lo que produce una tesis que no se sostiene ante el jurado.
 */
enum StageState {
  PENDIENTE
  EN_CURSO
  LISTO
}

/**
 * La memoria de una tesis, o de un artículo.
 * Hasta ahora el conector respondía y olvidaba: cada conversación empezaba de
 * cero y el tesista volvía a contar su tema, sus objetivos y su metodología. Si
 * abría un chat nuevo, había perdido el hilo. Esto es lo que faltaba para que
 * «sigue con mi tesis» signifique algo.
 * Uno por comprador y producto. Un tesista tiene UNA tesis; si además compra la
 * ruta del artículo, eso es otro proyecto y no debe mezclarse con el primero.
 * No se permiten dos tesis a la vez a propósito: es la forma más rápida de que
 * alguien escriba el capítulo IV de la que no era.
 */
model Project {
  id     String @id @default(uuid()) @db.Char(36)
  userId String @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Qué método sigue este proyecto. Mismo código que la licencia.
  productCode String @db.VarChar(40)

  /// El tema, tal y como el tesista lo tiene delimitado ahora mismo. Cambia:
  /// se guarda el vigente, no el histórico.
  tema        String? @db.VarChar(500)
  carrera     String? @db.VarChar(160)
  universidad String? @db.VarChar(160)
  /// El autor o tesista de la investigación, para la portada del Word.
  /// Nulo = se usa el nombre de la cuenta (User.firstName/lastName) como respaldo.
  autor       String? @db.VarChar(160)

  /// Los capítulos del DOCUMENTO cuando su facultad los numera de otra forma
  /// que el método. Nulo = la estructura del catálogo, que es lo de siempre.
  /// Ver `project.esquema`.
  esquema Json?
  /// Su asesor, como sale en la portada del Word («Dr. Juan Pérez Gómez»).
  /// Nulo = no se ha preguntado; vacío = todavía no tiene, y no hay que
  /// volver a preguntárselo.
  asesor  String? @db.VarChar(160)

  /// La fase por la que el tesista eligió retomar desde el panel (su clave de
  /// skill). Nula = la de siempre: la que esté en curso o la primera sin
  /// cerrar. Deja de contar sola en cuanto esa fase queda LISTA.
  retomarEn String? @db.VarChar(80)

  /// La norma de citas del Word: uno de los quince estilos de Zotero y el
  /// idioma de las citas. Nulos = APA 7 en español, que es como salía el Word
  /// antes de que se pudiera elegir. Ver `project.normas`.
  estiloCitas String? @db.VarChar(64)
  idiomaCitas String? @db.VarChar(8)

  /// Solo del informe estudiantil: curso, docente, integrantes, ciclo y sección,
  /// fecha de entrega y rúbrica. Nulo en tesis y artículo, que no la usan.
  /// Ver `projects/project.ficha-informe.js`.
  fichaInforme Json?

  /// Cuándo subió la plantilla de su facultad, y cómo se llamaba el archivo.
  /// La hoja de estilos vive en disco; aquí solo la marca de que existe.
  plantillaAt     DateTime?
  plantillaNombre String?   @db.VarChar(200)

  /// Las tesis de una misma persona y método. Un comprador tiene solo la 0; un
  /// administrador puede abrir más (1, 2…) para probar. La 0 es la que nace
  /// sola desde el conector, y su unicidad es lo que impide que dos llamadas
  /// simultáneas de Claude creen dos proyectos para el mismo tesista.
  ranura     Int      @default(0)
  /// Cómo la llama quien tiene varias, para distinguirlas en el panel.
  nombre     String?  @db.VarChar(80)
  /// La tesis activa es la de fecha más reciente: con la que trabaja el
  /// conector y la que enseña el panel. Elegir otra es ponerle la fecha de ahora.
  activadaAt DateTime @default(now())

  /// Qué consejos de la plataforma se le dieron por el conector y cuándo:
  /// { "fuentes": "2026-09-14T…", "analisis": "…" }. Sirve para no repetir el
  /// mismo cada conversación. Ver `project.consejos`.
  consejos Json?

  /// Cuántas veces su dueño lo devolvió al comienzo con «empezar de cero».
  /// Tiene un tope (ver `projects/project.service`), y vive en la fila porque
  /// reiniciar vacía el proyecto pero no lo borra: así no se pone a cero solo.
  reinicios Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages ProjectStage[]

  @@unique([userId, productCode, ranura])
  @@map("projects")
}

/**
 * Lo que quedó decidido en un capítulo.
 * `resumen` es prosa corta y es lo que de verdad se usa: se le entrega al
 * asistente al empezar el capítulo siguiente para que no pregunte lo que ya se
 * habló. `datos` queda para cuando las Skills devuelvan estado estructurado
 * —variables, población, diseño— y todavía no lo hacen; existe para que ese
 * trabajo tenga dónde caer sin otra migración.
 * No guarda el texto del capítulo. Esto es la memoria de lo acordado, no el
 * documento: el documento es otra etapa y otro problema.
 */
model ProjectStage {
  id        String  @id @default(uuid()) @db.Char(36)
  projectId String  @db.Char(36)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// La clave del capítulo, la misma que usa `redactar`. No es clave foránea
  /// contra `skills` porque un capítulo retirado del catálogo no puede borrar
  /// el avance de nadie.
  skillCode String @db.VarChar(64)

  estado  StageState @default(PENDIENTE)
  /// Qué quedó decidido, en dos o tres frases.
  resumen String?    @db.Text
  /// Lo mismo pero estructurado, cuando lo haya.
  datos   Json?

  /// Cuántas palabras tiene el capítulo escrito, y cuándo se guardó.
  ///
  /// El TEXTO no está aquí: vive en disco, porque esta base va en un plan
  /// compartido que ya pesa 171 MB. Aquí solo queda lo que hace falta para
  /// enseñarlo en el panel sin abrir un archivo por capítulo.
  palabras Int       @default(0)
  textoAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, skillCode])
  @@index([projectId, estado])
  @@map("project_stages")
}

/// El Zotero de UN tesista.
///
/// No confundir con el corpus de la casa: aquel es una sola biblioteca, con una
/// clave que es de Acosta y vive en el `.env`, y su marcador de versión está en
/// `reference_sync`, que es una fila única. Esto es una fila POR PERSONA, con su
/// clave, su colección y su propio marcador — y por eso la sincronización de
/// bibliotecas no puede reutilizar aquella: se pisarían la versión unas a otras.
model ZoteroAccount {
  id     String @id @default(uuid()) @db.Char(36)
  userId String @unique @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// El id NUMÉRICO de su cuenta en Zotero, que es lo que forma la ruta de la
  /// API (`users/12345/items`). No es el nombre de usuario, que se puede
  /// cambiar; lo devuelve el propio intercambio de OAuth.
  zoteroUserId String  @db.VarChar(32)
  /// Su nombre en Zotero, solo para enseñárselo y que reconozca qué conectó.
  username     String? @db.VarChar(120)

  /// La clave de API, CIFRADA. Ver `shared/utils/secretos.js`.
  ///
  /// Nunca sale de aquí en claro: ni al panel, ni en un log, ni enmascarada.
  /// La emite Zotero a nombre del tesista cuando autoriza, y se pide de solo
  /// lectura y sin acceso a sus grupos.
  apiKeyCipher String @db.VarChar(500)

  /// La colección que eligió, y su nombre para enseñarlo.
  ///
  /// NULA = conectó pero todavía no ha elegido, y en ese estado no se
  /// sincroniza nada. Es deliberado: la biblioteca de un tesista lleva años de
  /// asignaturas encima, y traerla entera le llenaría sus propias búsquedas de
  /// ruido que él no puso.
  collectionKey  String? @db.VarChar(16)
  collectionName String? @db.VarChar(200)

  /// Hasta qué versión de su biblioteca se trajo. Es lo que hace incremental la
  /// pasada siguiente: a Zotero se le pide `since=` y devuelve solo lo tocado.
  libraryVersion Int       @default(0)
  lastRunAt      DateTime?
  /// Cuántas fuentes suyas quedaron tras la última pasada.
  lastCount      Int       @default(0)

  /// Cerrojo, con la misma forma que el del corpus: la hora de entrada y no un
  /// sí/no, para poder soltarlo si el proceso murió a media pasada. Aquí es por
  /// persona, así que dos tesistas sincronizan a la vez sin estorbarse.
  runningSince DateTime?

  /// Lo último que falló, tal cual, para poder decírselo en el panel. Una
  /// conexión que dejó de funcionar —porque revocó la clave en Zotero— tiene
  /// que verse ahí y no solo en el log del servidor.
  lastError String? @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("zotero_accounts")
}

/// El pagaré de un OAuth a medias.
///
/// OAuth 1.0a tiene tres pasos y el segundo ocurre FUERA: el tesista se va a
/// zotero.org y vuelve. Al volver trae el token, pero el secreto que hace falta
/// para canjearlo se generó en el primer paso y hay que haberlo guardado.
///
/// Y se guarda de quién es. El que vuelve podría no traer sesión —vuelve de otro
/// dominio— así que la identidad se saca de esta fila y no de la cookie: es una
/// cosa menos que puede fallar, y evita que el token de uno pueda canjearlo
/// otro.
///
/// Las filas viejas se barren: un intercambio que nadie terminó no tiene por qué
/// seguir aquí mañana.
model ZoteroOauthRequest {
  token        String @id @db.VarChar(64)
  /// Cifrado también. Es efímero, pero con él y el token se completa el canje.
  secretCipher String @db.VarChar(500)
  userId       String @db.Char(36)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("zotero_oauth_requests")
}

/// El Mendeley de UN tesista.
///
/// GEMELA DE `ZoteroAccount` en lo que hace —una carpeta elegida, una pasada
/// por noche, su cerrojo, su último fallo— y de `ScopusConnection` en cómo se
/// autoriza: Mendeley es OAuth 2, y el token de acceso vive UNA HORA. Por eso
/// se guardan los dos tokens, cifrados, y el de acceso se renueva antes de
/// cada pasada con el de refresco. Una clave que no caduca, como la de Zotero,
/// aquí no existe.
///
/// Las fuentes no están aquí: van a `references` con `origin = MENDELEY` y
/// `sourceRef = mendeley:<perfil>:<documento>`, por el mismo camino que todo lo
/// demás que es del tesista.
model MendeleyAccount {
  id     String @id @default(uuid()) @db.Char(36)
  userId String @unique @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// El id de su perfil en Mendeley (un UUID). Forma el prefijo de sus
  /// fuentes; lo devuelve `/profiles/me` al terminar de autorizar.
  profileId   String  @db.VarChar(64)
  /// Su nombre en Mendeley, solo para que reconozca qué cuenta conectó.
  displayName String? @db.VarChar(200)

  /// Los tokens, CIFRADOS. Ver `shared/utils/secretos.js`. Nunca salen en
  /// claro: ni al panel, ni a un log, ni enmascarados.
  accessTokenCipher  String   @db.VarChar(2000)
  refreshTokenCipher String?  @db.VarChar(2000)
  /// Cuándo vence el de acceso. Se renueva un minuto antes.
  expiresAt          DateTime

  /// La carpeta que eligió, o «*» para toda la biblioteca. NULA = conectó
  /// pero no ha elegido, y en ese estado no se trae nada.
  folderId   String? @db.VarChar(64)
  folderName String? @db.VarChar(200)

  lastRunAt DateTime?
  /// Cuántas fuentes suyas quedaron tras la última pasada.
  lastCount Int       @default(0)

  /// Cerrojo por persona, con la hora de entrada: ver `ZoteroAccount`.
  runningSince DateTime?

  /// Lo último que falló, para decírselo en el panel.
  lastError String? @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mendeley_accounts")
}

/// El pagaré de un OAuth de Mendeley a medias.
///
/// Mismo papel que `ScopusOauthState`: el tesista se va a mendeley.com y
/// vuelve con un código, y la identidad de quién empezó sale de esta fila y
/// no de su sesión, que puede no viajar en una vuelta desde otro dominio.
/// Mendeley no admite PKCE, así que no hay verificador que guardar: lo que ata
/// la vuelta al navegador que empezó es el `state` en una cookie httpOnly.
model MendeleyOauthState {
  state  String @id @db.VarChar(64)
  userId String @db.Char(36)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("mendeley_oauth_states")
}

/// La conexión de un tesista con Scopus.
///
/// GEMELA DE `ZoteroAccount`, Y A PROPÓSITO: la misma forma —una fila por
/// persona, el secreto cifrado, el último fallo a la vista— para que quien
/// entienda una entienda la otra. Los nombres siguen los de aquella
/// (`userId`, `...Cipher`) en vez de los del boceto (`ownerUserId`,
/// `...Encrypted`): en esta base «ownerUserId» significa otra cosa —el dueño
/// de una FUENTE— y reutilizar el nombre para el dueño de una CONEXIÓN es
/// pedirle a alguien que confunda las dos tablas dentro de seis meses.
///
/// QUÉ GUARDA Y QUÉ NO
/// -------------------
/// Las FUENTES no están aquí: van a `references` por el mismo camino que el
/// export de Scopus y que el Zotero del tesista. Aquí vive solo la conexión.
///
/// POR QUÉ LOS TOKENS SON OPCIONALES
/// ---------------------------------
/// Porque hay dos formas de estar conectado y solo una tiene tokens. Ver
/// `ScopusConnectionMode`: con OAuth los hay y se cifran; con la clave de la
/// casa no hay ninguno que guardar, y la fila existe igualmente para poder
/// decir «conectado», recordar cuándo fue la última búsqueda y —lo que de
/// verdad importa— dejar constancia de que esta persona aceptó las
/// condiciones de uso del contenido de Elsevier.
model ScopusConnection {
  id     String @id @default(uuid()) @db.Char(36)
  userId String @unique @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Por dónde está conectado. Ver el enum.
  mode ScopusConnectionMode @default(APIKEY)

  /// Su identificador en Elsevier, si el intercambio lo devuelve. Solo para
  /// enseñárselo y que reconozca qué cuenta conectó; nunca se usa para filtrar
  /// nada, que para eso está `userId`.
  scopusUserId String? @db.VarChar(64)
  /// Su nombre o correo en Elsevier, por lo mismo.
  scopusName   String? @db.VarChar(200)

  /// Los tokens, CIFRADOS con AES-256-GCM. Ver `shared/utils/secretos.js`.
  ///
  /// Nunca salen de aquí en claro: ni al panel, ni a un log, ni enmascarados.
  /// Nulos en el modo de clave compartida, que no tiene ninguno.
  accessTokenCipher  String?   @db.VarChar(2000)
  refreshTokenCipher String?   @db.VarChar(2000)
  /// Cuándo caduca el de acceso. Nulo = no caduca o no se sabe.
  expiresAt          DateTime?

  status ScopusConnectionStatus @default(ACTIVA)

  /// Lo último que falló, tal cual, para poder decírselo en el panel. Igual
  /// que en Zotero: una conexión que dejó de funcionar tiene que verse ahí y
  /// no solo en el log del servidor.
  lastError String? @db.VarChar(500)

  lastSearchAt DateTime?
  /// Cuántas fuentes ha traído por aquí en total. Es lo que enseña la tarjeta.
  imported     Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("scopus_connections")
}

/// Una búsqueda de Scopus guardada, o una conversación con el copiloto.
///
/// Es la columna de la izquierda del buscador, como en la IA de Scopus: «Hoy»,
/// «Últimos 7 días»… Las del copiloto se guardan solas al llegar el resumen;
/// las de la búsqueda normal, cuando el tesista pulsa «Guardar búsqueda».
///
/// Se guarda lo que hace falta para VOLVER a ella, no los resultados: la
/// ecuación y el estado del buscador (modo, conceptos, sinónimos, filtros,
/// orden), y en las del copiloto el hilo de preguntas con sus resúmenes, que
/// es lo que costó una llamada a la IA. Los artículos se vuelven a pedir a
/// Scopus al abrirla: guardarlos sería almacenar su contenido, que es justo lo
/// que su acuerdo prohíbe.
model ScopusBusqueda {
  id     String @id @default(uuid()) @db.Char(36)
  userId String @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tipo     ScopusBusquedaTipo @default(BUSQUEDA)
  titulo   String             @db.VarChar(200)
  /// La ecuación completa que se mandó, filtros incluidos.
  ecuacion String             @db.Text
  /// El estado del buscador, tal como lo da la web. Con techo en el esquema.
  estado   Json
  /// Las preguntas y los resúmenes del copiloto. Nulo en las búsquedas normales.
  hilo     Json?
  /// Cuántos resultados dio, para enseñarlo en la lista.
  total    Int                @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
  @@map("scopus_busquedas")
}

enum ScopusBusquedaTipo {
  /// Guardada a mano desde la búsqueda normal o la avanzada.
  BUSQUEDA
  /// Una conversación con el copiloto; se guarda sola.
  COPILOTO
}

/// Cómo está autorizada una conexión de Scopus.
enum ScopusConnectionMode {
  /// Con la clave de la casa (`ELSEVIER_API_KEY`), que es de este servidor y
  /// no del tesista. Es lo único que Elsevier da por autoservicio hoy: el
  /// portal emite API Keys y nada más. «Conectar» aquí no es un intercambio
  /// de credenciales sino la aceptación de las condiciones de uso.
  APIKEY
  /// Con tokens del propio tesista, obtenidos por el flujo de autorización de
  /// Elsevier. Solo se puede usar cuando Elsevier habilite OAuth para esta
  /// aplicación y se rellenen sus endpoints en el `.env`.
  OAUTH
}

/// En qué estado está la conexión.
enum ScopusConnectionStatus {
  /// Funciona.
  ACTIVA
  /// El token de acceso venció y no hay refresco que valga. Se le pide volver
  /// a conectar. La fila se queda para no perder la cuenta de lo importado.
  CADUCADA
  /// Elsevier dejó de aceptarla —clave revocada, entitlement retirado—. Se
  /// distingue de CADUCADA porque no se arregla volviendo a pulsar el botón.
  REVOCADA
}

/// El pagaré de un OAuth de Scopus a medias.
///
/// Mismo papel que `ZoteroOauthRequest` y por las mismas razones: el paso de
/// en medio ocurre FUERA —el tesista se va a Elsevier y vuelve— y al volver
/// trae un código que hay que canjear con algo que se guardó al empezar.
///
/// Lo que se guarda aquí es el VERIFICADOR de PKCE, no un secreto de OAuth 1.
/// PKCE existe justo para esto: el código que vuelve por la barra de
/// direcciones no sirve de nada sin el verificador, que nunca salió de este
/// servidor. Va cifrado igual, porque una fila de la base no es un sitio donde
/// dejar en claro algo que autoriza un canje.
///
/// Y se guarda de quién es: el que vuelve llega desde otro dominio y su cookie
/// de sesión puede no viajar, así que la identidad sale de esta fila.
model ScopusOauthState {
  state          String @id @db.VarChar(64)
  verifierCipher String @db.VarChar(500)
  userId         String @db.Char(36)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("scopus_oauth_states")
}

enum ReclamoTipo {
  /// Disconformidad con el producto o el servicio.
  RECLAMO
  /// Disconformidad que no es con el producto o el servicio, o con la atención.
  QUEJA
}

enum ReclamoDocumento {
  DNI
  CE
  PASAPORTE
}

enum ReclamoBien {
  PRODUCTO
  SERVICIO
}

/// Una hoja del Libro de Reclamaciones.
///
/// Los campos son los del anexo del reglamento (D.S. 011-2011-PCM). La hoja y
/// su respuesta no se editan ni se borran desde la aplicación: es un libro, y
/// vale porque lo que dice hoy es lo que decía el día en que se escribió.
///
/// No cuelga de ninguna cuenta: la presenta cualquiera, con cuenta o sin ella,
/// y borrar una cuenta no puede llevarse sus hojas.
model Reclamo {
  /// El correlativo de la hoja. Lo da la base para que no se repita nunca.
  numero Int @id @default(autoincrement())

  tipo ReclamoTipo

  nombre          String           @db.VarChar(160)
  tipoDocumento   ReclamoDocumento
  numeroDocumento String           @db.VarChar(20)
  domicilio       String           @db.VarChar(250)
  telefono        String?          @db.VarChar(20)
  email           String           @db.VarChar(255)
  /// Padre, madre o apoderado, cuando reclama un menor de edad.
  apoderado       String?          @db.VarChar(160)

  tipoBien        ReclamoBien
  /// En soles. Nulo = no reclama un importe.
  montoReclamado  Decimal?    @db.Decimal(10, 2)
  descripcionBien String      @db.VarChar(500)

  detalle String @db.Text
  pedido  String @db.Text

  /// Quince días hábiles contados en Lima. Ver `reclamo.plazo`.
  fechaLimite DateTime

  respuesta       String?   @db.Text
  respondidoAt    DateTime?
  /// Sin relación a propósito: si ese administrador se va, lo contestado se queda.
  respondidoPorId String?   @db.Char(36)

  createdAt DateTime @default(now())

  @@index([respondidoAt])
  @@map("reclamos")
}

/// Un enlace corto para los que reparte el conector.
///
/// POR QUÉ EXISTE
/// --------------
/// Los enlaces de subida y descarga llevan un JWT de unos 400 caracteres, y el
/// asistente tiene que reproducirlo en la conversación. El 20-sep-2026 se
/// comprobó que ChatGPT NO lo copia: lo vuelve a escribir, y en 400 caracteres
/// al azar se equivoca en uno. Dos enlaces del mismo hilo traían identificadores
/// de usuario distintos —`…abfd9` y `…abfd4`— cuando ese dato no puede cambiar,
/// y la página contestaba «llegó incompleto o alterado» con el enlace aún
/// dentro de sus 30 minutos.
///
/// No hay instrucción que arregle eso: la única salida es que no haya nada
/// largo que copiar. Ocho caracteres los reproduce cualquier modelo sin fallar.
///
/// QUÉ GUARDA
/// ----------
/// El destino entero, con su token dentro. Así sirve para los nueve enlaces del
/// conector sin saber de qué tipo es cada uno. El token de aquí vale lo mismo
/// que el de la URL —media hora y un solo uso previsto—, así que esto no
/// guarda nada que no viajara ya por el chat.
///
/// LAS FILAS CADUCADAS NO SE BORRAN AL VENCER
/// ------------------------------------------
/// Se quedan para poder distinguir «venció» de «llegó incompleto», que es la
/// diferencia que el tesista necesita leer. Ver `enlaceNoVale`.
model EnlaceCorto {
  /// Ocho caracteres de un alfabeto sin parecidos (nada de 0/O ni 1/I/l).
  codigo String @id @db.VarChar(16)

  /// El enlace largo al que se redirige, con su JWT.
  destino String @db.VarChar(2000)

  /// La misma media hora que el token que lleva dentro.
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("enlaces_cortos")
}

// ─────────────────────────────────────────────────────────────────────────────
// El registro de asesores
// ─────────────────────────────────────────────────────────────────────────────

/// Quién puede llegar al formulario de asesores.
///
/// POR QUÉ EXISTE
/// --------------
/// El registro arranca cerrado: el enlace se reparte a dedo y no se anuncia en
/// ninguna parte. Pero «cerrado» no puede significar «sin desplegar», porque
/// entonces abrirlo al público sería un despliegue en vez de una decisión, y
/// eso obliga a esperar a que alguien tenga tiempo de desplegar. Por eso la
/// puerta es una fila: con `publica` en falso solo entra quien tiene el slug;
/// puesta en cierto, el formulario aparece además en /asesores. Abrir es un
/// clic en el panel.
///
/// El slug es aleatorio, como el de `TrialLink`: quien no lo tiene no lo
/// adivina. Si se filtra, se cierra esta convocatoria y se crea otra; las
/// fichas ya recibidas se quedan donde están.
/// Para qué sirve una puerta: a quién deja pasar y a qué formulario.
///
/// Son la misma mecánica —un slug que se reparte a mano y dos interruptores—
/// aplicada a los dos lados del servicio, así que comparten tabla en vez de
/// duplicar el mismo modelo con otro nombre.
enum ConvocatoriaTipo {
  /// Quien quiere revisar tesis: /asesores/<slug>.
  ASESORES
  /// Quien quiere que le revisen la suya: /revision/<slug>.
  REVISION
}

model Convocatoria {
  id String @id @default(uuid()) @db.Char(36)

  /// A qué formulario abre. Ver `ConvocatoriaTipo`.
  tipo ConvocatoriaTipo @default(ASESORES)

  /// Lo que va en la URL: /asesores/<slug> o /revision/<slug>.
  slug   String @unique @db.VarChar(40)
  /// Para quién es, visto desde el panel: «Piloto de revisión, setiembre».
  nombre String @db.VarChar(120)

  /// ¿Admite fichas? Cerrada, el enlace sigue abriendo y avisa de que ya no se
  /// reciben. Es más honesto que un 404 para quien llegó tarde con el enlace
  /// que le pasó un colega.
  abierta Boolean @default(true)
  /// ¿Se llega sin el enlace? Falso = solo con el slug.
  publica Boolean @default(false)

  /// Lo que se le dice al asesor al abrir la página. Aquí y no en el código
  /// para no tocar la web en cada campaña.
  intro String @default("") @db.VarChar(600)

  /// Sin relación a propósito, como en `Reclamo`: si ese administrador se va,
  /// la convocatoria y sus fichas se quedan.
  createdById String?  @db.Char(36)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  asesores Asesor[]

  @@map("convocatorias")
}

/// En qué punto está una ficha. Ninguna nace aprobada: nadie se autopublica.
enum AsesorEstado {
  PENDIENTE
  APROBADO
  RECHAZADO
}

/// El grado más alto que declara. Es lo que decide qué puede revisar: un
/// bachiller no observa la metodología de una tesis de maestría.
enum AsesorGrado {
  BACHILLER
  MAGISTER
  DOCTOR
}

enum AsesorDocumento {
  DNI
  CE
  PASAPORTE
}

/// Alguien que se ofrece a revisar tesis en la plataforma.
///
/// NO ES `Project.asesor`. Aquel es el nombre del asesor de la universidad tal
/// como va en la portada del Word, y es solo texto. Esto es una persona que
/// postula para trabajar aquí.
///
/// LO QUE NO SE PIDE
/// -----------------
/// Ni cuenta bancaria ni copia del documento. Las dos hacen falta para pagarle
/// y para firmar el acuerdo, o sea DESPUÉS de aprobarlo, y se le piden
/// entonces. Guardar datos de cobro de gente que quizá no entre es asumir la
/// custodia de algo que no se usa, que es justo lo contrario de lo que pide la
/// Ley 29733.
///
/// EL COMPROMISO SE GUARDA, NO SE SUPONE
/// -------------------------------------
/// `aceptaReglas` es el sí explícito a las tres que sostienen el servicio: no
/// redactar texto por el tesista, usar la plantilla de observaciones y aceptar
/// auditorías. Se guarda con la ficha porque es lo que se le recuerda el día
/// que haya que recordárselo.
model Asesor {
  id String @id @default(uuid()) @db.Char(36)

  /// Por qué convocatoria entró. NULO = lo dio de alta el administrador a
  /// mano, que es como entran los del piloto: no se postularon a nada, se les
  /// llamó. Obligarles a colgar de una convocatoria inventada sería escribir en
  /// la base una historia que no ocurrió.
  convocatoriaId String?       @db.Char(36)
  convocatoria   Convocatoria? @relation(fields: [convocatoriaId], references: [id], onDelete: Cascade)

  // ── Quién es ──────────────────────────────────────────────────────────
  nombre          String          @db.VarChar(160)
  tipoDocumento   AsesorDocumento @default(DNI)
  numeroDocumento String          @db.VarChar(20)
  /// Por donde se le contesta. Uno por ficha: ver el índice único de abajo.
  email           String          @db.VarChar(255)
  telefono        String          @db.VarChar(20)

  // ── Qué acredita ──────────────────────────────────────────────────────
  grado            AsesorGrado
  /// Dónde y cuándo lo obtuvo, para poder buscarlo en SUNEDU.
  gradoUniversidad String      @db.VarChar(160)
  gradoAnio        Int?
  /// El enlace o el código del grado en el Registro Nacional de Grados y
  /// Títulos. Vacío = habrá que buscarlo a mano antes de aprobar.
  registroSunedu   String      @default("") @db.VarChar(255)
  /// CV, LinkedIn o ORCID. Opcional: no se sube ningún archivo todavía.
  enlaceCv         String      @default("") @db.VarChar(500)

  // ── Qué puede revisar ─────────────────────────────────────────────────
  /// Códigos separados por coma. Ver `asesor.catalogo`.
  areas           String @db.VarChar(200)
  metodos         String @db.VarChar(120)
  /// Su campo, dicho por él: «Gestión educativa», «Salud pública».
  especialidad    String @db.VarChar(160)
  /// Las universidades cuyo reglamento de tesis conoce, separadas por coma.
  universidades   String @default("") @db.VarChar(500)
  anosExperiencia Int    @default(0)
  /// Lo que quiera contar en tres o cuatro frases. Es la mitad del criterio
  /// para aprobarlo, así que se guarda entero.
  presentacion    String @db.Text

  /// El sí a las tres reglas. Sin esto la ficha no se registra.
  aceptaReglas Boolean @default(false)

  // ── Qué se decidió ────────────────────────────────────────────────────
  estado AsesorEstado @default(PENDIENTE)
  /// Por qué se rechazó o qué quedó pendiente de comprobar. Solo del panel.
  notas  String?      @db.Text

  revisadoAt    DateTime?
  /// Sin relación, por lo mismo que `createdById` de la convocatoria.
  revisadoPorId String?   @db.Char(36)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// ¿Sale en el directorio? Aprobado pero invisible es el asesor que está
  /// lleno o de viaje: se apaga sin rechazarlo y vuelve cuando pueda. Un
  /// directorio donde figura quien no va a contestar es peor que uno corto.
  visible Boolean @default(true)

  /// Su llave privada: /asesor/<token>, donde ve sus encargos y los entrega.
  ///
  /// POR QUÉ UN ENLACE Y NO UNA CUENTA
  /// ---------------------------------
  /// Porque el encargo le llega directo del tesista que lo eligió, sin pasar
  /// por nadie, y para eso hace falta que pueda entrar HOY. Montarle registro,
  /// contraseña y recuperación de contraseña para que dos asesores revisen
  /// tesis es construir el edificio antes de saber si alguien va a vivir en él.
  /// Es la misma decisión que los enlaces de subida del conector: el enlace ES
  /// la llave. Se genera al aprobarlo y se puede rehacer si se le escapa.
  token String? @unique @db.VarChar(64)

  /// Los encargos que le mandaron los tesistas que lo eligieron. Ver `Pedido`.
  pedidos Pedido[]
  /// Lo que dijeron de él los tesistas a los que ya les entregó.
  resenas Resena[]

  /// Un correo, una ficha: quien insiste corrige la suya, no abre otra.
  @@unique([email])
  @@index([estado])
  @@index([convocatoriaId])
  @@map("asesores")
}

/// En qué punto está un encargo de revisión.
///
/// EL ENCARGO ESPERA A QUE SU ASESOR LO ACEPTE
/// -------------------------------------------
/// El tesista lo eligió, así que el encargo va directo a él, sin que nadie de
/// la casa lo reparta. Pero un asesor puede estar lleno, de viaje o ver que el
/// tema no es lo suyo, y obligarle a cargar con lo que le caiga produce
/// revisiones hechas de mala gana. Por eso ESPERANDO existe: es el hueco entre
/// «te lo mandaron» y «dije que sí».
///
/// Y mientras espera NO VE EL DOCUMENTO. Solo el tema, el capítulo, la
/// universidad y qué le preocupa al tesista, que es de sobra para decidir si
/// puede con ello. Así nadie recorre el catálogo leyendo tesis ajenas sin
/// comprometerse a nada: el Word se abre al aceptar.
enum PedidoEstado {
  /// Mandado a su asesor, todavía sin respuesta.
  ESPERANDO
  /// Aceptado: el asesor ya tiene el documento.
  EN_REVISION
  ENTREGADO
  /// El asesor no lo tomó. El tesista elige otro sin volver a subir nada.
  RECHAZADO
  CANCELADO
}

/// Nivel del trabajo. Decide quién puede revisarlo: un bachiller no observa la
/// metodología de una tesis de maestría.
enum PedidoNivel {
  PREGRADO
  MAESTRIA
  DOCTORADO
}

/// Un encargo de revisión: el capítulo que manda un tesista para que se lo
/// observen.
///
/// SIN CUENTA Y SIN PAGO
/// ---------------------
/// No se le pide registrarse: el embudo ya es bastante largo —hoy, para usar el
/// método, hace falta además una suscripción a Claude— y esto tiene que poder
/// probarlo alguien que llega desde un enlace de WhatsApp. Durante el piloto
/// tampoco se cobra aquí: lo que se está midiendo es si alguien entrega su
/// capítulo, no si paga, y el cobro se cierra aparte.
///
/// EL CÓDIGO ES LA LLAVE
/// ---------------------
/// Con él se consulta el estado en /pedido/<codigo>, sin sesión, igual que los
/// enlaces de subida que reparte el conector. Por eso es aleatorio y no
/// correlativo: un número de pedido que se adivina deja leer el de al lado.
///
/// EL ARCHIVO VA A DISCO
/// ---------------------
/// Como las guías y los capítulos. Una tesis en Word ronda el medio mega y no
/// tiene por qué engordar la base; el identificador da el nombre en disco, así
/// que cómo se llamara el archivo del tesista nunca decide dónde se escribe.
model Pedido {
  id String @id @default(uuid()) @db.Char(36)

  /// Lo que va en la URL del seguimiento. Aleatorio, ver la nota de arriba.
  codigo String @unique @db.VarChar(16)

  // ── Quién manda ───────────────────────────────────────────────────────
  nombre   String @db.VarChar(160)
  email    String @db.VarChar(255)
  telefono String @default("") @db.VarChar(20)

  // ── Qué manda ─────────────────────────────────────────────────────────
  universidad String      @db.VarChar(160)
  nivel       PedidoNivel @default(PREGRADO)
  /// Códigos del catálogo de áreas, el mismo que usan los asesores.
  area        String      @db.VarChar(40)
  metodo      String      @db.VarChar(40)
  /// Qué parte manda: un capítulo, el proyecto o la tesis entera.
  capitulo    String      @db.VarChar(40)
  /// Su tema, tal como lo tiene ahora.
  tema        String      @db.VarChar(500)
  /// Lo que quiere que se mire con más cuidado. Vacío = lo que haga falta.
  mensaje     String      @db.Text

  /// Cómo se llamaba el archivo que subió y cuánto pesa.
  archivoNombre String @default("") @db.VarChar(200)
  bytes         Int    @default(0)

  // ── Qué se hace con él ────────────────────────────────────────────────
  estado PedidoEstado @default(ESPERANDO)

  /// A quién eligió el tesista. Nulo solo si ese asesor se dio de baja después:
  /// un pedido nace con asesor, porque se manda desde su perfil. `SetNull` y no
  /// `Cascade`, que borrar a un asesor no puede llevarse por delante el
  /// encargo de un tesista.
  asesorId String? @db.Char(36)
  asesor   Asesor? @relation(fields: [asesorId], references: [id], onDelete: SetNull)

  /// El documento de observaciones que se le entrega, que durante el piloto es
  /// un Google Doc compartido. Es lo único que el tesista ve al final.
  enlaceObservaciones String @default("") @db.VarChar(500)

  /// Para el panel. No se le enseñan al tesista.
  notas String? @db.Text

  /// Por qué lo rechazó, en una frase. Se le enseña al tesista: «no puedo
  /// ahora» y «esto no es lo mío» le llevan a elegir cosas distintas.
  motivoRechazo String @default("") @db.VarChar(300)

  /// Cuándo se le mandó a este asesor. Cambia si el tesista elige otro.
  asignadoAt  DateTime?
  /// Cuándo dijo que sí. Es el momento en que se le abre el documento.
  aceptadoAt  DateTime?
  entregadoAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// Lo que dijo el tesista al recibir sus observaciones. Ver `Resena`.
  resena Resena?

  /// Lo que se han dicho el tesista y su asesor. Ver `Mensaje`.
  mensajes Mensaje[]

  @@index([estado])
  @@index([asesorId])
  @@map("pedidos")
}

/// Lo que el tesista dice de su asesor cuando recibe sus observaciones.
///
/// UNA POR PEDIDO, Y SOLO SI SE ENTREGÓ
/// ------------------------------------
/// Cuelga del pedido y no de la persona: así no hay forma de puntuar a alguien
/// con quien no se trabajó, ni de puntuarlo diez veces. Es lo único que
/// sostiene una nota cuando el directorio crezca y ya no se conozca a nadie.
///
/// LA NOTA NO SE ENSEÑA HASTA QUE SIGNIFIQUE ALGO
/// ----------------------------------------------
/// Con dos o tres reseñas, una media no informa: dice más del azar que del
/// asesor, y un 5,0 de una sola persona parece inflado. El perfil enseña
/// mientras tanto lo verificable —grado, universidades, años, tesis
/// revisadas—, que es más difícil de fingir que una estrella.
model Resena {
  id String @id @default(uuid()) @db.Char(36)

  /// Una por pedido. El índice único es lo que lo garantiza.
  pedidoId String @unique @db.Char(36)
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  asesorId String @db.Char(36)
  asesor   Asesor @relation(fields: [asesorId], references: [id], onDelete: Cascade)

  /// De 1 a 5.
  estrellas  Int
  /// Lo que quiera contar. Vacío = puso nota y no escribió nada.
  comentario String @default("") @db.Text

  createdAt DateTime @default(now())

  @@index([asesorId])
  @@map("resenas")
}

/// Quién escribió un mensaje.
enum MensajeDe {
  TESISTA
  ASESOR
}

/// La conversación de un encargo.
///
/// POR QUÉ EXISTE
/// --------------
/// Porque sin ella esto era un buzón: el tesista dejaba un archivo, el asesor
/// devolvía un enlace y entre medias no se hablaban. Quien entrega su tesis a
/// un desconocido y pasa días sin saber nada no está tranquilo, está esperando
/// a ver qué pasa; y el asesor que tiene una duda sobre el capítulo no tenía
/// dónde preguntarla salvo saliéndose a WhatsApp, que es justo donde se pierde
/// el rastro de todo.
///
/// EL ADJUNTO ES LO QUE CIERRA EL CICLO
/// ------------------------------------
/// Con las observaciones en la mano, el tesista corrige y vuelve a mandar su
/// documento POR AQUÍ, en un mensaje. Sin eso, una revisión terminaba y nadie
/// comprobaba nunca si lo observado se levantó, que es la mitad del trabajo de
/// un asesor de verdad.
///
/// SE LEE CUANDO LO LEE EL OTRO
/// ----------------------------
/// `leidoAt` lo sella quien lo recibe al abrir la conversación, no quien lo
/// escribe. Es lo que permite decir «tienes 2 sin leer» sin mentir.
model Mensaje {
  id String @id @default(uuid()) @db.Char(36)

  pedidoId String @db.Char(36)
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  de    MensajeDe
  texto String    @db.Text

  /// La versión corregida, o cualquier documento que acompañe al mensaje.
  /// Vacío = mensaje solo de texto, que es lo normal.
  archivoNombre String @default("") @db.VarChar(200)
  bytes         Int    @default(0)

  /// Cuándo lo leyó el otro lado. Nulo = todavía no.
  leidoAt DateTime?

  createdAt DateTime @default(now())

  @@index([pedidoId])
  @@map("mensajes")
}

/// El vector de un texto, calculado una vez y guardado para siempre.
///
/// Los usa la búsqueda por significado de Scopus. El vector de un artículo no
/// cambia nunca —mismo título y resumen, mismo vector—, pero se recordaba solo
/// en memoria y cada reinicio lo tiraba: el 20-sep se desplegó quince veces, y
/// cada vez se volvió a pedir a Gemini lo que ya se tenía, contra el tope de
/// cien textos por minuto del plan gratuito para toda la plataforma.
///
/// No es un dato de nadie: la clave es un hash del texto y el vector, el
/// resultado de una cuenta. Por eso no lleva usuario ni se borra con ninguno.
model VectorDeTexto {
  /// sha256 de modelo, tarea y texto, en hexadecimal.
  clave  String @id @db.Char(64)
  modelo String @db.VarChar(80)
  /// 768 números en coma flotante de 32 bits: 3 KB por vector.
  vector Bytes  @db.Blob

  createdAt DateTime @default(now())

  @@map("vectores_de_texto")
}

// ─────────────────────────────────────────────────────────────────────────────
// Preparar documento: edición de inglés académico, traducción y resúmenes
// ─────────────────────────────────────────────────────────────────────────────

enum DocPackStatus {
  ACTIVE
  EXPIRED // solo informativo: la caducidad de verdad se compara con `expiresAt`
  REVOKED
}

/// La membresía que da derecho a preparar documentos.
///
/// POR QUÉ NO ES UNA BOLSA COMO LA DE PALABRAS
/// -------------------------------------------
/// Una `WordPack` se gasta: tiene un total y un consumido, y cuando se igualan
/// se acabó. Aquí no hay total que gastar. Hay un CAUDAL: diez documentos al
/// mes mientras la membresía esté viva. Guardar «diez» y restar dejaría a quien
/// compró la trimestral con diez documentos para noventa días, que no es lo que
/// se vendió.
///
/// Por eso no hay columna de consumidos: lo gastado se cuenta mirando las
/// `Preparacion` de la ventana en curso. Es una cuenta más cara que leer un
/// entero, pero es la única que no puede desincronizarse de la realidad, y son
/// diez filas por mes y persona.
///
/// LA VENTANA
/// ----------
/// Ventanas de treinta días desde `activatedAt`, no meses del calendario. Con
/// el calendario, quien compra el 28 tiene diez documentos hasta el 30 y otros
/// diez el día 1: veinte en cuatro días por S/ 29. Con ventanas propias, cada
/// mes de membresía vale un mes.
model DocPack {
  id String @id @default(uuid()) @db.Char(36)

  userId String @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId String @db.Char(36)
  plan   Plan   @relation(fields: [planId], references: [id])

  /// Documentos al mes, copiados del plan al comprar. Se copia y no se lee del
  /// plan a propósito: subir mañana la mensual a quince no puede cambiar lo que
  /// se le vendió a quien compró ayer, ni al revés.
  docsPorMes Int

  status DocPackStatus @default(ACTIVE)

  /// Desde cuándo cuentan las ventanas de treinta días. Una renovación NO lo
  /// mueve: si se moviera, renovar el día 20 regalaría un mes nuevo de cupo.
  activatedAt DateTime @default(now())
  expiresAt   DateTime

  /// Trazabilidad del cobro, igual que en `WordPack`.
  paymentMethod String? @db.VarChar(30)
  paymentRef    String? @db.VarChar(80)
  amountCents   Int?
  note          String? @db.VarChar(255)

  /// Administrador que la activó a mano. Null si vino de una pasarela.
  grantedById String? @db.Char(36)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments      Payment[]
  preparaciones Preparacion[]

  @@index([userId, status, expiresAt])
  @@map("doc_packs")
}

/// Los tres servicios de «Preparar documento».
enum PreparacionServicio {
  EDICION // inglés académico, con control de cambios
  TRADUCCION // a español, inglés, portugués o chino
  RESUMEN // resumen, abstract y palabras clave
}

enum PreparacionEstado {
  EN_COLA // aceptada; el turno aún no ha llegado
  EN_CURSO // el motor la está trabajando
  LISTO // el Word terminado está en disco
  FALLIDO // no salió; NO gasta cupo
}

/// Un documento mandado a preparar.
///
/// Es, a la vez, el encargo y el recibo: de ella salen el cupo consumido del
/// mes (las que no están `FALLIDO`) y el historial que ve el cliente.
///
/// El .docx NO se guarda aquí. Ni el de entrada ni el de salida: son megas por
/// fila y la base ya va justa. Van al disco, en la carpeta de preparaciones,
/// que el respaldo diario ya recoge. Ver `preparar.storage`.
model Preparacion {
  id String @id @default(uuid()) @db.Char(36)

  userId String @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// La membresía que la pagó. Se apunta para poder reconstruir después qué
  /// entregó cada compra, aunque el cupo no se cuente por aquí.
  docPackId String?  @db.Char(36)
  docPack   DocPack? @relation(fields: [docPackId], references: [id])

  servicio PreparacionServicio
  /// Solo en TRADUCCION: a qué idioma. `es`, `en`, `pt` o `zh`.
  idioma   String?             @db.VarChar(5)

  /// Nombre del archivo tal y como lo subió el cliente, para devolvérselo con
  /// un nombre que reconozca.
  nombre   String @db.VarChar(255)
  /// Palabras sobre las que se trabaja, sin la bibliografía ni el índice. En
  /// traducción entran además las tablas, los rótulos, las notas al pie y el
  /// encabezado, que es todo lo que se traduce. No decide el precio —la
  /// membresía es de tamaño libre— pero sí se le enseña y sirve para saber
  /// cuánto cuesta de verdad cada entrega.
  palabras Int
  bytes    Int

  estado PreparacionEstado @default(EN_COLA)
  /// Por qué falló, escrito para que lo lea el cliente.
  error  String?           @db.VarChar(500)

  /// Cuántos párrafos se tocaron y cuántos quedaron intactos.
  tocados  Int @default(0)
  intactos Int @default(0)

  /// POR QUÉ quedaron intactos, agrupado por motivo y por parte del documento,
  /// como JSON: `[{ donde, motivo, cuantos, ejemplo }]`. Antes solo se guardaba
  /// el número y la web rellenaba el motivo a mano, con lo que decía «llevaban
  /// una nota al pie» hasta en documentos que no tienen ninguna.
  avisos String? @db.Text

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  entregadoAt DateTime?

  @@index([userId, createdAt])
  @@index([docPackId, createdAt])
  @@index([estado, createdAt])
  @@map("preparaciones")
}
